---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGenreStats } from '../../utils/kpop';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const genres = await getGenreStats();

const genreDescriptions: Record<string, { icon: string; desc: string }> = {
  'dance-pop': { icon: '✨', desc: 'Upbeat tempos, infectious choreography, energetic hooks and memorable slang.' },
  'rnb-soul': { icon: '🎙️', desc: 'Smooth vocal lines, conversational storytelling, emotional inflection and expressive particles.' },
  'hip-hop': { icon: '🔥', desc: 'Dynamic cadence, rhythmic rhymes, wordplay, modern youth vernacular and rapid diction.' },
  'ballad-ost': { icon: '🎻', desc: 'Poetic metaphors, drama OST themes, deep sentimental expressions and formal grammar.' },
  'rock-band': { icon: '🎸', desc: 'Passionate anthems, relatable youth struggles, vivid verbs and colloquial contractions.' },
  'indie-acoustic': { icon: '☕', desc: 'Mellow melodies, everyday conversational Korean, cozy metaphors and relaxed speech.' },
};
---

<BaseLayout
  title="K-Pop Music Genres Hub | Learn Korean with K-Pop"
  description="Browse Korean learning lessons categorized by musical genre: Dance & Pop, R&B, Hip-Hop, Ballads, and K-Drama OSTs."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200/60 mb-3">
        🎶 Musical Diversity
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight mb-4">
        Explore by Music Genre
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Every genre offers a distinct style of Korean—from energetic dance hooks to emotional ballad poetry and witty hip-hop rhymes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {genres.map(g => {
        const meta = genreDescriptions[g.slug] || { icon: '🎵', desc: 'Explore Korean vocabulary and grammar through this musical style.' };
        return (
          <a
            href={g.href}
            class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs hover:shadow-md hover:border-indigo-400 transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{meta.icon}</span>
                <span class="text-xs font-bold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full">
                  {g.count} song{g.count !== 1 ? 's' : ''}
                </span>
              </div>
              <h2 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-2">
                {g.name}
              </h2>
              <p class="text-xs text-slate-500 leading-relaxed">
                {meta.desc}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-indigo-600">
              <span>Browse Lessons</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
