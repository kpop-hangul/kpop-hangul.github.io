---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getGenreSlug, getGenreName } from '../../utils/slug';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);

  const knownGenres = ['dance-pop', 'rnb-soul', 'hip-hop', 'ballad-ost', 'rock-band', 'indie-acoustic'];
  const postGenres = allPosts.map(p => getGenreSlug(p.data.genre || ''));
  const uniqueGenres = [...new Set([...knownGenres, ...postGenres])];

  return uniqueGenres.map(slug => {
    const filtered = allPosts
      .filter(p => getGenreSlug(p.data.genre || '') === slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { genre: slug },
      props: {
        genreSlug: slug,
        genreName: getGenreName(slug),
        posts: filtered,
      },
    };
  });
}

const { genreSlug, genreName, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${genreName} K-Pop Korean Lessons | Learn Korean with K-Pop`}
  description={`Learn Korean through top ${genreName} K-Pop tracks. Breakdown of lyrics, grammar points, and vocabulary.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-indigo-600 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/genres/`} class="hover:text-indigo-600 transition-colors">Genres</a>
      <span>/</span>
      <span class="text-indigo-600 font-semibold">{genreName}</span>
    </nav>

    <div class="mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 mb-2">
        Genre Collection
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {genreName}
      </h1>
      <p class="text-slate-600 text-sm mt-2 max-w-2xl">
        Showing {posts.length} Korean learning lesson{posts.length !== 1 ? 's' : ''} in the {genreName} genre.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {posts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            difficulty={post.data.difficulty}
            genre={post.data.genre}
            artist={post.data.artist}
            songTitle={post.data.songTitle}
            hangulTitle={post.data.hangulTitle}
            chartRank={post.data.chartRank}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-3xl border border-slate-200">
        <div class="text-4xl mb-3">🎵</div>
        <h3 class="text-lg font-bold text-slate-800 mb-1">No songs yet in this genre</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto">
          New songs are added automatically every day from Melon and Spotify top charts. Stay tuned!
        </p>
      </div>
    )}
  </div>
</BaseLayout>
