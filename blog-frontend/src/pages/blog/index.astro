---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getDifficultyStats, getGenreStats } from '../../utils/kpop';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const difficulties = await getDifficultyStats();
const genres = await getGenreStats();
---

<BaseLayout
  title="All K-Pop Korean Song Lessons | K-Pop Hangul"
  description="Browse all K-Pop song breakdowns to learn Korean Hangul, vocabulary, grammar, and pronunciation. Updated daily with top charts."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 mb-2">
        Complete Song Catalog
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        All Korean Song Lessons ({sortedPosts.length})
      </h1>
      <p class="text-slate-600 text-sm mt-1">
        Explore every song analyzed with line-by-line Hangul lyrics, Romanization, and grammar points.
      </p>
    </div>

    <!-- Quick Filter Bars -->
    <div class="p-5 bg-white rounded-2xl border border-slate-200 shadow-2xs mb-8 space-y-3">
      <!-- By Level -->
      <div class="flex items-center gap-2 flex-wrap text-xs">
        <span class="font-bold text-slate-500 uppercase tracking-wider min-w-[70px]">Level:</span>
        <a href={`${base}/difficulty/`} class="px-2.5 py-1 rounded-lg bg-indigo-600 text-white font-semibold">
          All Levels
        </a>
        {difficulties.map(d => (
          <a href={d.href} class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 font-medium transition-colors">
            {d.badge} ({d.count})
          </a>
        ))}
      </div>

      <!-- By Genre -->
      <div class="flex items-center gap-2 flex-wrap text-xs pt-3 border-t border-slate-100">
        <span class="font-bold text-slate-500 uppercase tracking-wider min-w-[70px]">Genre:</span>
        <a href={`${base}/genres/`} class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 font-medium transition-colors">
          All Genres
        </a>
        {genres.map(g => (
          <a href={g.href} class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 font-medium transition-colors">
            {g.name} ({g.count})
          </a>
        ))}
      </div>
    </div>

    <!-- Post Grid -->
    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {sortedPosts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            difficulty={post.data.difficulty}
            genre={post.data.genre}
            artist={post.data.artist}
            songTitle={post.data.songTitle}
            hangulTitle={post.data.hangulTitle}
            chartRank={post.data.chartRank}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-slate-200">
        <div class="text-4xl mb-3">🎵</div>
        <h3 class="text-lg font-bold text-slate-800 mb-1">No songs published yet</h3>
        <p class="text-slate-500 text-sm">Our automated pipeline will generate lessons from today's top charts.</p>
      </div>
    )}
  </div>
</BaseLayout>
