---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import ThumbnailCard from '../../components/ThumbnailCard.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getPostSummary } from '../../utils/summary';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="전체 아티클 목록 | 앱시안(absian)"
  description="AI 활용법, 개발 생산성, 자동화 부업 파이프라인 등 앱시안(absian)의 모든 아티클 목록입니다."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header with View Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1">Archive</div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">전체 아티클 ({sortedPosts.length})</h1>
        <p class="text-slate-600 text-sm mt-1">최신 순으로 정렬된 모든 테크 & 실전 가이드입니다.</p>
      </div>

      <!-- View Switcher Tabs -->
      <div class="inline-flex items-center p-1 bg-slate-100/90 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 self-start sm:self-auto">
        <button
          id="btn-feed-view"
          class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-white text-blue-600 shadow-xs transition-all cursor-pointer"
          title="상세 카드 피드형으로 보기"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>피드형 (상세)</span>
        </button>
        <button
          id="btn-grid-view"
          class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-slate-500 hover:text-slate-800 transition-all cursor-pointer"
          title="썸네일 그리드형으로 더 많은 글 한눈에 보기"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>🖼️ 썸네일 모아보기</span>
        </button>
      </div>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    {sortedPosts.length > 0 ? (
      <>
        <!-- 1. 카드 피드 뷰 (3열, 상세 요약문 포함) -->
        <div id="feed-view-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
          {sortedPosts.map(post => (
            <Card
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              category={post.data.category}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage}
              tags={post.data.tags}
            />
          ))}
        </div>

        <!-- 2. 컴팩트 썸네일 그리드 뷰 (4열, 썸네일 중심 한눈에 보기) -->
        <div id="grid-view-container" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5 my-8">
          {sortedPosts.map(post => (
            <ThumbnailCard
              title={post.data.title}
              summary={getPostSummary(post)}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200">
        <p class="text-slate-500 text-sm">아직 작성된 글이 없습니다.</p>
      </div>
    )}

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline>
    (function () {
      const feedBtn = document.getElementById('btn-feed-view');
      const gridBtn = document.getElementById('btn-grid-view');
      const feedContainer = document.getElementById('feed-view-container');
      const gridContainer = document.getElementById('grid-view-container');

      if (!feedBtn || !gridBtn || !feedContainer || !gridContainer) return;

      function setView(mode) {
        if (mode === 'grid') {
          feedContainer.classList.add('hidden');
          gridContainer.classList.remove('hidden');

          gridBtn.classList.add('bg-white', 'text-blue-600', 'shadow-xs');
          gridBtn.classList.remove('text-slate-500');

          feedBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-xs');
          feedBtn.classList.add('text-slate-500');
          localStorage.setItem('absian_view_mode', 'grid');
        } else {
          gridContainer.classList.add('hidden');
          feedContainer.classList.remove('hidden');

          feedBtn.classList.add('bg-white', 'text-blue-600', 'shadow-xs');
          feedBtn.classList.remove('text-slate-500');

          gridBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-xs');
          gridBtn.classList.add('text-slate-500');
          localStorage.setItem('absian_view_mode', 'feed');
        }
      }

      feedBtn.addEventListener('click', () => setView('feed'));
      gridBtn.addEventListener('click', () => setView('grid'));

      // URL 파라미터(?view=grid) 또는 로컬스토리지 기억
      const params = new URLSearchParams(window.location.search);
      const savedMode = params.get('view') || localStorage.getItem('absian_view_mode');
      if (savedMode === 'grid') {
        setView('grid');
      }
    })();
  </script>
</BaseLayout>
