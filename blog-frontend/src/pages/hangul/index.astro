---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 14 Basic Consonants
const consonants = [
  { char: 'ㄱ', name: '기역 (giyeok)', sound: 'g / k', example: '가요 (Gayo - Korean Pop)', audioText: '기역, 가요' },
  { char: 'ㄴ', name: '니은 (nieun)', sound: 'n', example: '노래 (Norae - Song)', audioText: '니은, 노래' },
  { char: 'ㄷ', name: '디귿 (digeut)', sound: 'd / t', example: '댄스 (Daenseu - Dance)', audioText: '디귿, 댄스' },
  { char: 'ㄹ', name: '리을 (rieul)', sound: 'r / l', example: '리듬 (Rideum - Rhythm)', audioText: '리을, 리듬' },
  { char: 'ㅁ', name: '미음 (mieum)', sound: 'm', example: '멜로디 (Mellodi - Melody)', audioText: '미음, 멜로디' },
  { char: 'ㅂ', name: '비읍 (bieup)', sound: 'b / p', example: '보컬 (Bokeol - Vocal)', audioText: '비읍, 보컬' },
  { char: 'ㅅ', name: '시옷 (siot)', sound: 's', example: '스타 (Seuta - Star)', audioText: '시옷, 스타' },
  { char: 'ㅇ', name: '이응 (ieung)', sound: 'silent / -ng', example: '음악 (Eum-ak - Music)', audioText: '이응, 음악' },
  { char: 'ㅈ', name: '지읒 (jieut)', sound: 'j', example: '주인공 (Juingong - Main Character)', audioText: '지읒, 주인공' },
  { char: 'ㅊ', name: '치읓 (chieut)', sound: 'ch', example: '차트 (Chateu - Chart)', audioText: '치읓, 차트' },
  { char: 'ㅋ', name: '키읔 (kieuk)', sound: 'k (aspirated)', example: '콘서트 (Konseoteu - Concert)', audioText: '키읔, 콘서트' },
  { char: 'ㅌ', name: '티읕 (tieut)', sound: 't (aspirated)', example: '트랙 (Teuraek - Track)', audioText: '티읕, 트랙' },
  { char: 'ㅍ', name: '피읖 (pieup)', sound: 'p (aspirated)', example: '팬덤 (Paendeom - Fandom)', audioText: '피읖, 팬덤' },
  { char: 'ㅎ', name: '히읗 (hieut)', sound: 'h', example: '히트곡 (Hiteugok - Hit Song)', audioText: '히읗, 히트곡' },
];

// 10 Basic Vowels
const vowels = [
  { char: 'ㅏ', roman: 'a', sound: 'ah like "father"', example: '하트 (Heart)', audioText: '아, 하트' },
  { char: 'ㅑ', roman: 'ya', sound: 'yah like "yard"', example: '약속 (Promise)', audioText: '야, 약속' },
  { char: 'ㅓ', roman: 'eo', sound: 'uh like "cup / song"', example: '너 (You)', audioText: '어, 너' },
  { char: 'ㅕ', roman: 'yeo', sound: 'yuh like "young"', example: '여기 (Here)', audioText: '여, 여기' },
  { char: 'ㅗ', roman: 'o', sound: 'oh like "go / home"', example: '오늘 (Today)', audioText: '오, 오늘' },
  { char: 'ㅛ', roman: 'yo', sound: 'yoh like "yo-yo"', example: '요즘 (These days)', audioText: '요, 요즘' },
  { char: 'ㅜ', roman: 'u', sound: 'oo like "moon"', example: '우리 (We / Us)', audioText: '우, 우리' },
  { char: 'ㅠ', roman: 'yu', sound: 'yoo like "music / you"', example: '유행 (Trend)', audioText: '유, 유행' },
  { char: 'ㅡ', roman: 'eu', sound: 'eu like "brook / put" with spread lips', example: '느낌 (Feeling)', audioText: '으, 느낌' },
  { char: 'ㅣ', roman: 'i', sound: 'ee like "see / meet"', example: '이름 (Name)', audioText: '이, 이름' },
];

// 5 Double Consonants
const doubleConsonants = [
  { char: 'ㄲ', name: '쌍기역 (ssang-giyeok)', sound: 'tense kk', example: '꿈 (Kkum - Dream)', audioText: '쌍기역, 꿈' },
  { char: 'ㄸ', name: '쌍디귿 (ssang-digeut)', sound: 'tense tt', example: '떨려 (Tteollyeo - Nervous)', audioText: '쌍디귿, 떨려' },
  { char: 'ㅃ', name: '쌍비읍 (ssang-bieup)', sound: 'tense pp', example: '빨리 (Ppalli - Quickly)', audioText: '쌍비읍, 빨리' },
  { char: 'ㅆ', name: '쌍시옷 (ssang-siot)', sound: 'tense ss', example: '싸움 (Ssaum - Fight)', audioText: '쌍시옷, 싸움' },
  { char: 'ㅉ', name: '쌍지읒 (ssang-jieut)', sound: 'tense jj', example: '진짜 (Jinjja - Real/Really)', audioText: '쌍지읒, 진짜' },
];

// Essential K-Pop Catchphrases
const kpopWords = [
  { hangul: '대박', roman: 'Daebak', meaning: 'Awesome / Jackpot / Big hit', audioText: '대박' },
  { hangul: '심쿵', roman: 'Simkung', meaning: 'Heart attack (from cuteness or crush)', audioText: '심쿵' },
  { hangul: '사랑해', roman: 'Saranghae', meaning: 'I love you (casual)', audioText: '사랑해' },
  { hangul: '보고 싶어', roman: 'Bogo sipeo', meaning: 'I miss you', audioText: '보고 싶어' },
  { hangul: '영원히', roman: 'Yeong-wonhi', meaning: 'Forever and ever', audioText: '영원히' },
  { hangul: '빛나', roman: 'Bin-na', meaning: 'Shine / Sparkling', audioText: '빛나' },
];
---

<BaseLayout
  title="Hangul 101: The Complete Korean Alphabet Guide for K-Pop Fans"
  description="Master the Korean alphabet (Hangul) from scratch: 14 basic consonants, 10 vowels, 5 double consonants, syllable blocks, and batchim rules with native audio."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-4">
        <span>📖 Hangul 101 Primer</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Master the <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500">Korean Alphabet</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Hangul (한글) is widely celebrated by linguists as one of the most logical and scientific writing systems in human history. You can learn to read any K-Pop title in just 60 minutes!
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs">
        <a href="#consonants" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 font-medium transition-colors">14 Consonants ↓</a>
        <a href="#vowels" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 font-medium transition-colors">10 Vowels ↓</a>
        <a href="#blocks" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 font-medium transition-colors">Syllable Blocks ↓</a>
        <a href="#kpop-words" class="px-3.5 py-1.5 rounded-full bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition-colors">K-Pop Catchphrases 🔊</a>
      </div>
    </div>

    <!-- Section 1: 14 Basic Consonants -->
    <section id="consonants" class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>1. The 14 Basic Consonants</span>
            <span class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-0.5 rounded-full font-bold border border-indigo-200/60">자음 (Ja-eum)</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Click the 🔊 audio button on any card to hear native Korean pronunciation.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {consonants.map(c => (
          <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs hover:border-indigo-400 hover:shadow-md transition-all group">
            <div class="flex items-start justify-between mb-2">
              <span class="text-3xl font-black text-indigo-600 group-hover:scale-110 transition-transform inline-block">
                {c.char}
              </span>
              <button
                type="button"
                data-tts={c.audioText}
                class="tts-btn p-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-indigo-600 hover:text-white transition-colors cursor-pointer text-xs flex items-center gap-1"
                title="Listen to native Korean pronunciation"
                aria-label={`Listen to ${c.char}`}
              >
                <span>🔊</span>
              </button>
            </div>
            <div class="text-xs font-bold text-slate-900">{c.name}</div>
            <div class="text-xs text-slate-500 font-mono mt-0.5">Sound: <span class="text-indigo-600 font-semibold">{c.sound}</span></div>
            <div class="mt-3 pt-2.5 border-t border-slate-100 text-[11px] text-slate-600">
              <span class="text-slate-400 block text-[10px] uppercase font-semibold">K-Pop Song Example:</span>
              <span class="font-medium text-slate-800">{c.example}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: 10 Basic Vowels -->
    <section id="vowels" class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>2. The 10 Basic Vowels</span>
            <span class="text-xs bg-purple-50 text-purple-600 px-2.5 py-0.5 rounded-full font-bold border border-purple-200/60">모음 (Mo-eum)</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Korean vowels represent Heaven (• / stroke), Earth (ㅡ / horizontal), and Human (ㅣ / vertical).</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
        {vowels.map(v => (
          <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs hover:border-purple-400 hover:shadow-md transition-all group">
            <div class="flex items-start justify-between mb-2">
              <span class="text-3xl font-black text-purple-600 group-hover:scale-110 transition-transform inline-block">
                {v.char}
              </span>
              <button
                type="button"
                data-tts={v.audioText}
                class="tts-btn p-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-purple-600 hover:text-white transition-colors cursor-pointer text-xs"
                title="Listen to native pronunciation"
                aria-label={`Listen to ${v.char}`}
              >
                <span>🔊</span>
              </button>
            </div>
            <div class="text-xs font-bold text-slate-900">[{v.roman}]</div>
            <div class="text-[11px] text-slate-500 mt-1 leading-tight">{v.sound}</div>
            <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-slate-600">
              <span class="text-slate-400 block text-[9px] uppercase font-semibold">Example:</span>
              <span class="font-medium text-slate-800">{v.example}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: 5 Double Consonants -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>3. The 5 Double Consonants</span>
            <span class="text-xs bg-rose-50 text-rose-600 px-2.5 py-0.5 rounded-full font-bold border border-rose-200/60">쌍자음 (Ssang-jaeum)</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Pronounced with a tight, glottal tension in your throat without blowing air out.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {doubleConsonants.map(dc => (
          <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs hover:border-rose-400 hover:shadow-md transition-all group">
            <div class="flex items-start justify-between mb-2">
              <span class="text-3xl font-black text-rose-600 group-hover:scale-110 transition-transform inline-block">
                {dc.char}
              </span>
              <button
                type="button"
                data-tts={dc.audioText}
                class="tts-btn p-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-rose-600 hover:text-white transition-colors cursor-pointer text-xs"
                title="Listen to native pronunciation"
                aria-label={`Listen to ${dc.char}`}
              >
                <span>🔊</span>
              </button>
            </div>
            <div class="text-xs font-bold text-slate-900">{dc.name}</div>
            <div class="text-xs text-slate-500 font-mono mt-0.5">Sound: <span class="text-rose-600 font-semibold">{dc.sound}</span></div>
            <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] text-slate-600">
              <span class="text-slate-400 block text-[9px] uppercase font-semibold">Example:</span>
              <span class="font-medium text-slate-800">{dc.example}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4: How Syllables are Built -->
    <section id="blocks" class="mb-16 bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
      <h2 class="text-2xl font-extrabold text-slate-900 mb-4 flex items-center gap-2">
        <span>🧱 How Korean Syllable Blocks Work</span>
      </h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-6">
        Unlike English which strings letters out linearly from left to right (e.g., K-O-R-E-A), Hangul arranges letters into geometric square blocks. Every block represents exactly one spoken syllable and must begin with an initial consonant!
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 2-Element Block (C + V) -->
        <div class="p-6 rounded-2xl bg-indigo-50/50 border border-indigo-100 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase text-indigo-700 tracking-wider mb-3">Type A: Consonant + Vertical Vowel (Horizontal Duo)</div>
            
            <!-- SVG Diagram -->
            <div class="flex items-center justify-center my-4">
              <svg width="240" height="110" viewBox="0 0 240 110" class="overflow-visible">
                <!-- Initial Box -->
                <rect x="10" y="10" width="90" height="90" rx="16" fill="#e0e7ff" stroke="#6366f1" stroke-width="2" stroke-dasharray="4 4" />
                <text x="55" y="55" text-anchor="middle" dominant-baseline="central" font-size="34" font-weight="900" fill="#4338ca">ㄴ</text>
                <text x="55" y="85" text-anchor="middle" font-size="10" font-weight="bold" fill="#6366f1">Initial (n)</text>

                <text x="110" y="55" text-anchor="middle" dominant-baseline="central" font-size="20" font-weight="bold" fill="#94a3b8">+</text>

                <!-- Vowel Box -->
                <rect x="130" y="10" width="90" height="90" rx="16" fill="#f3e8ff" stroke="#a855f7" stroke-width="2" stroke-dasharray="4 4" />
                <text x="175" y="55" text-anchor="middle" dominant-baseline="central" font-size="34" font-weight="900" fill="#7e22ce">ㅏ</text>
                <text x="175" y="85" text-anchor="middle" font-size="10" font-weight="bold" fill="#a855f7">Vowel (a)</text>
              </svg>
            </div>

            <div class="flex items-center gap-3 p-3 bg-white rounded-xl border border-indigo-100 shadow-2xs">
              <div class="w-12 h-12 rounded-lg bg-indigo-600 text-white text-2xl font-black flex items-center justify-center flex-shrink-0">
                나
              </div>
              <div class="text-xs text-slate-700">
                <strong class="text-slate-900 block text-sm">나 (na)</strong>
                <span>Pronounced "nah", meaning "I / Me" (Informal)</span>
              </div>
              <button type="button" data-tts="나" class="tts-btn ml-auto p-2 bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-600 rounded-lg transition-colors cursor-pointer text-sm">
                🔊
              </button>
            </div>
          </div>
          <p class="text-xs text-slate-500 mt-4">Initial consonant sits on the left, and the vertical vowel sits on the right.</p>
        </div>

        <!-- 3-Element Block (C + V + C / Batchim) -->
        <div class="p-6 rounded-2xl bg-pink-50/50 border border-pink-100 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase text-pink-700 tracking-wider mb-3">Type B: Consonant + Vowel + Final Floor (Batchim)</div>
            
            <!-- SVG Diagram -->
            <div class="flex items-center justify-center my-4">
              <svg width="240" height="110" viewBox="0 0 240 110" class="overflow-visible">
                <!-- Initial Box -->
                <rect x="20" y="8" width="85" height="42" rx="10" fill="#e0e7ff" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="3 3" />
                <text x="62" y="29" text-anchor="middle" dominant-baseline="central" font-size="20" font-weight="900" fill="#4338ca">ㅎ (h)</text>

                <!-- Vowel Box -->
                <rect x="115" y="8" width="85" height="42" rx="10" fill="#f3e8ff" stroke="#a855f7" stroke-width="1.5" stroke-dasharray="3 3" />
                <text x="157" y="29" text-anchor="middle" dominant-baseline="central" font-size="20" font-weight="900" fill="#7e22ce">ㅏ (a)</text>

                <!-- Batchim Box -->
                <rect x="20" y="58" width="180" height="44" rx="10" fill="#fce7f3" stroke="#ec4899" stroke-width="2" />
                <text x="110" y="80" text-anchor="middle" dominant-baseline="central" font-size="20" font-weight="900" fill="#be185d">ㄴ [Batchim: n]</text>
              </svg>
            </div>

            <div class="flex items-center gap-3 p-3 bg-white rounded-xl border border-pink-100 shadow-2xs">
              <div class="w-12 h-12 rounded-lg bg-pink-600 text-white text-2xl font-black flex items-center justify-center flex-shrink-0">
                한
              </div>
              <div class="text-xs text-slate-700">
                <strong class="text-slate-900 block text-sm">한 (han)</strong>
                <span>Root for "Korea / Great", as in Hangul (한글)</span>
              </div>
              <button type="button" data-tts="한" class="tts-btn ml-auto p-2 bg-pink-50 hover:bg-pink-600 hover:text-white text-pink-600 rounded-lg transition-colors cursor-pointer text-sm">
                🔊
              </button>
            </div>
          </div>
          <p class="text-xs text-slate-500 mt-4">The bottom consonant is known as <strong>Batchim (받침)</strong>, forming the sonic floor of the syllable.</p>
        </div>
      </div>
    </section>

    <!-- Section 5: Advanced Pronunciation & Batchim Sound Rules -->
    <section class="mb-16 bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>🗣️ Master 3 Essential K-Pop Sound Change Rules</span>
            <span class="text-xs bg-rose-50 text-rose-600 px-2.5 py-0.5 rounded-full font-bold border border-rose-200/60">Fluency Secrets</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Why do K-Pop lyrics sound different from how they look on paper? Master these 3 phonetic rules to sing and shadow like an idol!
          </p>
        </div>
      </div>

      <div class="space-y-6">
        <!-- Rule 1: Liaison (연음 법칙) -->
        <div class="p-5 rounded-2xl bg-indigo-50/40 border border-indigo-100">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span class="px-2 py-0.5 bg-indigo-600 text-white rounded text-xs font-semibold">Rule 1</span>
              Liaison (연음 법칙 - Linking Sound)
            </h3>
            <span class="text-[11px] text-indigo-700 font-semibold bg-indigo-100/70 px-2 py-0.5 rounded-full">Most Frequent</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-3">
            When a syllable ends in a consonant (Batchim) and the next syllable starts with the silent consonant <strong>ㅇ</strong>, the batchim moves up into the empty spot!
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-white p-3 rounded-xl border border-indigo-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">음악 → [으막]</span>
                <span class="text-[11px] text-slate-500 block">Music (eum-ak → eu-mak)</span>
              </div>
              <button type="button" data-tts="음악, 으막" class="tts-btn p-1.5 bg-indigo-50 rounded-lg text-indigo-600 hover:bg-indigo-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
            <div class="bg-white p-3 rounded-xl border border-indigo-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">눈앞 → [누납]</span>
                <span class="text-[11px] text-slate-500 block">Before eyes (nun-ap → nu-nap)</span>
              </div>
              <button type="button" data-tts="눈앞, 누납" class="tts-btn p-1.5 bg-indigo-50 rounded-lg text-indigo-600 hover:bg-indigo-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
            <div class="bg-white p-3 rounded-xl border border-indigo-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">한국어 → [한구거]</span>
                <span class="text-[11px] text-slate-500 block">Korean (han-guk-eo → han-gu-geo)</span>
              </div>
              <button type="button" data-tts="한국어, 한구거" class="tts-btn p-1.5 bg-indigo-50 rounded-lg text-indigo-600 hover:bg-indigo-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
          </div>
        </div>

        <!-- Rule 2: Nasalization (비음화) -->
        <div class="p-5 rounded-2xl bg-amber-50/40 border border-amber-100">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span class="px-2 py-0.5 bg-amber-600 text-white rounded text-xs font-semibold">Rule 2</span>
              Nasalization (비음화 - Smooth Flow)
            </h3>
            <span class="text-[11px] text-amber-700 font-semibold bg-amber-100/70 px-2 py-0.5 rounded-full">Natural Speech</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-3">
            When stop batchims (ㄱ, ㄷ, ㅂ) collide with nasal consonants (ㄴ, ㅁ), they transform into their smooth nasal counterparts (ㅇ, ㄴ, ㅁ) for effortless singing speed.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-white p-3 rounded-xl border border-amber-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">빛난 → [빈난]</span>
                <span class="text-[11px] text-slate-500 block">Shone (From RESCENE - Love Attack)</span>
              </div>
              <button type="button" data-tts="빛난, 빈난" class="tts-btn p-1.5 bg-amber-50 rounded-lg text-amber-600 hover:bg-amber-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
            <div class="bg-white p-3 rounded-xl border border-amber-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">국물 → [궁물]</span>
                <span class="text-[11px] text-slate-500 block">Soup / Broth (guk-mul → gung-mul)</span>
              </div>
              <button type="button" data-tts="국물, 궁물" class="tts-btn p-1.5 bg-amber-50 rounded-lg text-amber-600 hover:bg-amber-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
          </div>
        </div>

        <!-- Rule 3: Tensification (경음화) -->
        <div class="p-5 rounded-2xl bg-purple-50/40 border border-purple-100">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span class="px-2 py-0.5 bg-purple-600 text-white rounded text-xs font-semibold">Rule 3</span>
              Tensification (경음화 - Strong Consonants)
            </h3>
            <span class="text-[11px] text-purple-700 font-semibold bg-purple-100/70 px-2 py-0.5 rounded-full">Emphasis</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-3">
            When plain consonants (ㄱ, ㄷ, ㅂ, ㅅ, ㅈ) follow a stop batchim, they harden into double tense sounds (ㄲ, ㄸ, ㅃ, ㅆ, ㅉ).
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-white p-3 rounded-xl border border-purple-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">학교 → [학꾜]</span>
                <span class="text-[11px] text-slate-500 block">School (hak-gyo → hak-kkyo)</span>
              </div>
              <button type="button" data-tts="학교, 학꾜" class="tts-btn p-1.5 bg-purple-50 rounded-lg text-purple-600 hover:bg-purple-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
            <div class="bg-white p-3 rounded-xl border border-purple-100 flex items-center justify-between shadow-2xs">
              <div>
                <span class="text-sm font-bold text-slate-900">잡다 → [잡따]</span>
                <span class="text-[11px] text-slate-500 block">To hold / grasp (jap-da → jap-tta)</span>
              </div>
              <button type="button" data-tts="잡다, 잡따" class="tts-btn p-1.5 bg-purple-50 rounded-lg text-purple-600 hover:bg-purple-600 hover:text-white cursor-pointer text-xs">🔊</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Essential K-Pop Catchphrases with Audio -->
    <section id="kpop-words" class="mb-16">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-200">
