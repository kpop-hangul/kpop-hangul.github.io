  </div>

  <!-- Web SpeechSynthesis Native Korean TTS Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const ttsButtons = document.querySelectorAll('.tts-btn');

      if (!('speechSynthesis' in window)) {
        console.warn('SpeechSynthesis is not supported in this browser environment.');
        return;
      }

      ttsButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-tts');
          if (!text) return;

          // Stop any currently playing audio
          window.speechSynthesis.cancel();

          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'ko-KR';
          utterance.rate = 0.85; // Slightly slower for language learners
          utterance.pitch = 1.0;

          // Visual active pulse
          btn.classList.add('ring-2', 'ring-indigo-400', 'scale-110');
          utterance.onend = () => {
            btn.classList.remove('ring-2', 'ring-indigo-400', 'scale-110');
          };
          utterance.onerror = () => {
            btn.classList.remove('ring-2', 'ring-indigo-400', 'scale-110');
          };

          window.speechSynthesis.speak(utterance);
        });
      });
    });
  </script>
