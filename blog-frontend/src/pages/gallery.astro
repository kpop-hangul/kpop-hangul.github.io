---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { getDifficultyStats, getGenreStats } from '../utils/kpop';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const difficulties = await getDifficultyStats();
const genres = await getGenreStats();

// Available filter presets
const filterOptions = [
  { label: 'All Songs', value: 'all' },
  { label: '🟢 Beginner', value: 'Beginner' },
  { label: '🟡 Intermediate', value: 'Intermediate' },
  { label: '🔴 Advanced', value: 'Advanced' },
  ...genres.map(g => ({ label: g.name, value: g.name }))
];
---

<BaseLayout
  title="Visual Song Archive | K-Pop Hangul"
  description="Explore all chart-topping K-Pop song lessons by difficulty level, genre, and artist in a visual card gallery."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-3 border border-indigo-100">
        <span>🖼️ Visual Song Archive</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Explore K-Pop Korean Lessons
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-2 leading-relaxed">
        Browse {sortedPosts.length} top-charting Melon & Spotify songs broken down into structured Korean learning modules.
      </p>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="filter-buttons">
        {filterOptions.map((opt, idx) => (
          <button
            data-filter={opt.value}
            class={`px-4 py-1.5 text-xs font-semibold rounded-full transition-all cursor-pointer ${
              idx === 0
                ? 'bg-indigo-600 text-white shadow-xs filter-btn-active'
                : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200/80'
            }`}
          >
            {opt.label} {opt.value === 'all' ? `(${sortedPosts.length})` : ''}
          </button>
        ))}
      </div>
    </div>

    <!-- Responsive Card Grid -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-10"
    >
      {sortedPosts.map(post => {
        const diff = post.data.difficulty || 'Beginner';
        const genre = post.data.genre || 'Dance & Pop';
        const artist = post.data.artist || '';
        return (
          <div
            class="gallery-item transition-all"
            data-difficulty={diff}
            data-genre={genre}
            data-artist={artist}
          >
            <Card
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              difficulty={post.data.difficulty}
              genre={post.data.genre}
              artist={post.data.artist}
              songTitle={post.data.songTitle}
              hangulTitle={post.data.hangulTitle}
              chartRank={post.data.chartRank}
              chartSource={post.data.chartSource}
            />
          </div>
        );
      })}
    </div>

    <!-- Empty Filter Result Message -->
    <div id="no-results" class="hidden text-center py-20 bg-white rounded-3xl border border-slate-200 shadow-sm">
      <div class="text-4xl mb-3">🔍</div>
      <p class="text-slate-700 font-semibold text-base mb-1">No songs found in this category yet.</p>
      <p class="text-slate-400 text-xs">Try selecting another difficulty level or music genre above.</p>
    </div>
  </div>

  <!-- Realtime Filter Script -->
  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('#filter-buttons button');
      const items = document.querySelectorAll('.gallery-item');
      const noResults = document.getElementById('no-results');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-filter');

          // Update active button classes
          buttons.forEach((b) => {
            b.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs', 'filter-btn-active');
            b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');
          });
          btn.classList.add('bg-indigo-600', 'text-white', 'shadow-xs', 'filter-btn-active');
          btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200/80');

          // Filter grid items
          let visibleCount = 0;
          items.forEach((item) => {
            const itemDiff = item.getAttribute('data-difficulty') || '';
            const itemGenre = item.getAttribute('data-genre') || '';

            if (selected === 'all' || itemDiff.includes(selected) || itemGenre.includes(selected)) {
              item.style.display = '';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          });

          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0);
          }
        });
      });
    })();
  </script>
</BaseLayout>

