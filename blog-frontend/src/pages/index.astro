---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getDifficultyStats, getGenreStats, getArtistStats } from '../utils/kpop';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 9);
const featuredPosts = sortedPosts.slice(0, 3);

const difficulties = await getDifficultyStats();
const genres = await getGenreStats();
const artists = await getArtistStats();
---

<BaseLayout
  title={`${siteConfig.site.name} - Master Korean with K-Pop Song Lyrics`}
  description={siteConfig.site.description}
>
  <!-- 1. Hero Section -->
  <section class="relative bg-gradient-to-b from-indigo-900 via-slate-900 to-slate-950 text-white overflow-hidden py-16 sm:py-24 border-b border-indigo-900/50">
    <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#818cf8_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Tagline pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold mb-6">
        <span>🏆 Updated Daily from Melon & Spotify Top Charts</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-6xl font-black tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        Learn Korean with <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-indigo-400 via-pink-400 to-purple-400 bg-clip-text text-transparent">
          Chart-Topping K-Pop Hits
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
        Sing your favorite songs with 100% understanding! Detailed line-by-line Hangul lyrics, accurate Romanization, essential vocabulary tables, and grammar breakdowns.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <a
          href={`${base}/difficulty/`}
          class="px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2"
        >
          <span>🎯 Choose Your Level</span>
          <span>→</span>
        </a>
        <a
          href={`${base}/search/`}
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 backdrop-blur-md transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search Any Song or Artist</span>
        </a>
      </div>

      <!-- 3 Difficulty Level Quick Links -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        <a
          href={`${base}/difficulty/beginner/`}
          class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-emerald-500/30 text-left transition-all group"
        >
          <div class="text-xs font-bold text-emerald-400 mb-1 flex items-center justify-between">
            <span>🟢 Level 1</span>
            <span class="text-[10px] text-slate-400">TOPIK I</span>
          </div>
          <div class="text-sm font-bold text-white group-hover:text-emerald-300">Beginner</div>
          <div class="text-[11px] text-slate-400 mt-1">Catchy hooks & core words</div>
        </a>

        <a
          href={`${base}/difficulty/intermediate/`}
          class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-amber-500/30 text-left transition-all group"
        >
          <div class="text-xs font-bold text-amber-400 mb-1 flex items-center justify-between">
            <span>🟡 Level 2</span>
            <span class="text-[10px] text-slate-400">TOPIK II</span>
          </div>
          <div class="text-sm font-bold text-white group-hover:text-amber-300">Intermediate</div>
          <div class="text-[11px] text-slate-400 mt-1">Conversations & idioms</div>
        </a>

        <a
          href={`${base}/difficulty/advanced/`}
          class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-rose-500/30 text-left transition-all group"
        >
          <div class="text-xs font-bold text-rose-400 mb-1 flex items-center justify-between">
            <span>🔴 Level 3</span>
            <span class="text-[10px] text-slate-400">TOPIK II+</span>
          </div>
          <div class="text-sm font-bold text-white group-hover:text-rose-300">Advanced</div>
          <div class="text-[11px] text-slate-400 mt-1">Fast rap & poetic lyrics</div>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Daily Top Chart Feature Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/80 mb-2">
          🔥 Today's Top 3 Chart Hits
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Fresh From Melon & Spotify
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          3 new songs analyzed and added every morning.
        </p>
      </div>

      <a
        href={`${base}/blog/`}
        class="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 hover:text-indigo-700"
      >
        View All Songs ({allPosts.length}) →
      </a>
    </div>

    <!-- 3 Featured Song Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {featuredPosts.map(post => (
        <Card
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.slug}
          category={post.data.category}
          difficulty={post.data.difficulty}
          genre={post.data.genre}
          artist={post.data.artist}
          songTitle={post.data.songTitle}
          hangulTitle={post.data.hangulTitle}
          chartRank={post.data.chartRank}
          chartSource={post.data.chartSource}
          readingTime={post.data.readingTime}
          heroImage={post.data.heroImage}
          tags={post.data.tags}
        />
      ))}
    </div>

    <!-- Music Genres Quick Filter Bar -->
    <div class="p-6 bg-slate-50 rounded-3xl border border-slate-200/80 mb-16">
      <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
        Filter by Music Genre
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={`${base}/blog/`}
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-2xs"
        >
          All Genres
        </a>
        {genres.map(g => (
          <a
            href={g.href}
            class="px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 border border-slate-200 transition-colors"
          >
            {g.name} <span class="text-[10px] text-slate-400 ml-1">({g.count})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- All Recent Song Lessons -->
    {recentPosts.length > 3 && (
      <div>
        <div class="mb-6">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">
            Latest Korean Song Lessons
          </h3>
          <p class="text-xs text-slate-500 mt-1">Explore recently analyzed tracks</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.slice(3).map(post => (
            <Card
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              category={post.data.category}
              difficulty={post.data.difficulty}
              genre={post.data.genre}
              artist={post.data.artist}
              songTitle={post.data.songTitle}
              hangulTitle={post.data.hangulTitle}
              chartRank={post.data.chartRank}
              chartSource={post.data.chartSource}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage}
              tags={post.data.tags}
            />
          ))}
        </div>
      </div>
    )}

    <!-- Why Learn Korean with K-Pop Section -->
    <section class="mt-20 pt-16 border-t border-slate-200">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
          Why Learn Korean with K-Pop?
        </h2>
        <p class="text-sm text-slate-600">
          Traditional textbooks teach stiff formal language. K-Pop songs teach natural, emotional, and memorable spoken Korean.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs">
          <div class="text-2xl mb-3">🎧</div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Authentic Spoken Korean</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Learn real colloquial expressions, modern youth slang, and natural sentence endings used in daily Seoul conversations.
          </p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs">
          <div class="text-2xl mb-3">🧠</div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Rhythmic Memory Recall</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Catchy melodies and repetitive hooks anchor vocabulary in long-term memory effortlessly without boring flashcard drills.
          </p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs">
          <div class="text-2xl mb-3">🗣️</div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Shadowing & Pronunciation</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Singing along naturally trains your vocal muscles for native batchim linking (연음) and smooth Korean consonant transitions.
          </p>
        </div>

        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-2xs">
          <div class="text-2xl mb-3">📅</div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Daily Top 3 Consistency</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            New chart hits added every day keep your study sessions fresh, trendy, and tied directly to the songs you already love.
          </p>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
