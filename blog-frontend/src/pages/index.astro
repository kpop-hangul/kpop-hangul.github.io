---
import BaseLayout from '../layouts/BaseLayout.astro';
import { learningPath } from '../data/learningPath';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="K-Pop Hangul | Start with the Korean Alphabet"
  description="Start learning Hangul with a clear beginner reading path. Find Korean consonant and vowel charts, syllable-block diagrams, and an alphabet reference in English."
>
  <section class="bg-gradient-to-b from-indigo-950 to-slate-950 text-white py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-wider text-indigo-300 mb-5">For curious K-Pop fans</p>
      <h1 class="text-4xl sm:text-6xl max-w-3xl font-black tracking-tight leading-tight">Start with the<br /><span class="text-indigo-300">Korean alphabet.</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">New to Hangul? Begin with the letter charts, explore the syllable diagrams, and return to the reference whenever you need it.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}/start/`} class="rounded-xl bg-indigo-500 hover:bg-indigo-400 px-6 py-3 font-bold">Find your starting point →</a>
        <a href={`${base}/hangul/`} class="rounded-xl border border-slate-600 hover:border-indigo-300 px-6 py-3 font-semibold">Open the alphabet guide</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="alphabet-reference" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="max-w-2xl mb-8">
      <h2 id="alphabet-reference" class="text-2xl sm:text-3xl font-extrabold text-slate-900">Find the section you need</h2>
      <p class="mt-3 leading-relaxed text-slate-600">Go straight to a chart or follow the <a href={`${base}/start/#study-path`} class="font-semibold text-indigo-700 underline underline-offset-4">beginner reading path</a>. These links open sections of our existing Hangul guide.</p>
    </div>
    <ol class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {learningPath.map((step, index) => (
        <li class="rounded-2xl bg-white border border-slate-200 p-6">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Reference {index + 1}</span>
          <h3 class="mt-2 text-xl font-bold text-slate-900"><a href={`${base}/hangul/#${step.id}`} class="hover:text-indigo-700 underline decoration-indigo-200 underline-offset-4">{step.title}</a></h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{step.description}</p>
        </li>
      ))}
      <li class="rounded-2xl bg-indigo-50 border border-indigo-200 p-6">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">Choose your own pace</span>
        <h3 class="mt-2 text-xl font-bold text-slate-900"><a href={`${base}/start/`} class="hover:text-indigo-700 underline decoration-indigo-200 underline-offset-4">Not sure where to begin?</a></h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">Choose between starting with letters, moving to syllable blocks, or revisiting a reference.</p>
      </li>
    </ol>
  </section>
</BaseLayout>
