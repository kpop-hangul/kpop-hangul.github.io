---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { learningPath } from '../../data/learningPath';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const startingPoints = [
  { title: 'I am new to Hangul', description: 'Begin with the letter charts, then move to the block diagrams.', href: `${base}/hangul/#consonants`, link: 'Start with consonants' },
  { title: 'I recognize some letters', description: 'Go directly to the block diagrams. Keep the vowel chart nearby if you need it.', href: `${base}/hangul/#blocks`, link: 'Go to syllable blocks' },
  { title: 'I want a quick review', description: 'Use the section list below to return to a specific chart or reference.', href: '#study-path', link: 'Choose a section' },
];
---

<BaseLayout
  title="Start Learning Hangul: A Beginner Reading Path"
  description="New to the Korean alphabet? Find your starting point with direct links to the consonant and vowel charts, syllable diagrams, and pronunciation reference."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-slate-500">
      <a href={`${base}/`} class="hover:text-indigo-700 underline underline-offset-4">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span aria-current="page">Start here</span>
    </nav>

    <header class="max-w-3xl mb-10">
      <p class="text-sm font-bold uppercase tracking-wider text-indigo-600 mb-3">Your first stop</p>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900">Start learning Hangul</h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">Looking for the Korean alphabet? This page brings the existing Hangul guide into one reading path. Choose the point that feels useful to you and move at your own pace.</p>
    </header>

    <section aria-labelledby="starting-point" class="mb-14">
      <h2 id="starting-point" class="text-2xl font-extrabold text-slate-900 mb-5">Where would you like to begin?</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {startingPoints.map(point => (
          <div class="flex flex-col rounded-2xl bg-white border border-slate-200 p-6">
            <h3 class="font-bold text-lg text-slate-900">{point.title}</h3>
            <p class="mt-3 mb-5 text-sm leading-relaxed text-slate-600">{point.description}</p>
            <a href={point.href} class="mt-auto text-sm font-bold text-indigo-700 underline underline-offset-4 hover:text-indigo-900">{point.link} →</a>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm text-slate-500">These are navigation choices, not a placement test or an exam-level assessment.</p>
    </section>

    <section id="study-path" aria-labelledby="study-path-title" class="scroll-mt-24">
      <h2 id="study-path-title" class="text-2xl font-extrabold text-slate-900">Your alphabet reading path</h2>
      <p class="mt-2 mb-6 text-slate-600">Read in this order or open the section you want to revisit. Every link stays within the alphabet guide.</p>
      <ol class="space-y-4">
        {learningPath.map((step, index) => (
          <li class="flex gap-4 rounded-2xl bg-white border border-slate-200 p-5 sm:p-6">
            <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 font-extrabold text-indigo-700">{index + 1}</span>
            <div>
              <h3 class="text-lg font-bold text-slate-900">{step.title}</h3>
              <p class="mt-1 mb-3 text-sm leading-relaxed text-slate-600">{step.description}</p>
              <a href={`${base}/hangul/#${step.id}`} class="text-sm font-semibold text-indigo-700 underline underline-offset-4 hover:text-indigo-900">{step.label} →</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="using-reference" class="mt-12 rounded-2xl bg-slate-900 p-6 sm:p-8 text-white">
      <h2 id="using-reference" class="text-xl font-bold">Keep the reference handy</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300">Use the section links to return to a chart as you read. The guide's audio buttons use your browser's speech synthesis, so voice availability depends on your browser and device.</p>
      <a href={`${base}/hangul/`} class="mt-5 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-bold text-indigo-800 hover:bg-indigo-50">Open the full Hangul guide →</a>
    </section>
  </div>
</BaseLayout>
