---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Contact & Song Requests | K-Pop Hangul"
  description="Have a K-Pop song you want to learn Korean with? Or a question about grammar and Hangul? Reach out to the K-Pop Hangul team."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-pink-500 flex items-center justify-center text-white font-bold text-lg shadow-sm">
          💌
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Contact Editorial Team</h1>
          <p class="text-slate-500 text-xs mt-0.5">Song suggestions, grammar questions & collaborations</p>
        </div>
      </div>

      <p class="text-slate-600 text-sm mb-8 leading-relaxed">
        Is there a specific K-Pop track you want broken down into a Korean lesson? Did you spot a nuance or typo in our Hangul translations? We love hearing from fellow K-Pop learners worldwide!
      </p>

      <div class="space-y-6">
        <!-- Direct Email Card -->
        <div class="p-5 bg-gradient-to-r from-indigo-50/80 to-purple-50/80 border border-indigo-100 rounded-2xl text-xs text-slate-700 leading-relaxed">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="font-bold text-indigo-900 mb-1 flex items-center gap-1.5 text-sm">
                <span>📧 Direct Editorial Mail</span>
              </p>
              <p class="text-slate-600">
                Editorial Inbox: <code class="bg-white px-2 py-0.5 rounded border border-indigo-200 text-indigo-700 font-mono font-semibold">kpophangul.team@gmail.com</code>
              </p>
              <p class="text-slate-500 mt-1">We typically respond to educational queries within 24–48 hours.</p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a
                href="mailto:kpophangul.team@gmail.com?subject=[K-Pop%20Hangul%20Song%20Request]"
                class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-sm transition-colors text-center"
              >
                Send Email ↗
              </a>
              <button
                type="button"
                id="copyEmailBtn"
                class="px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-700 font-medium rounded-lg border border-slate-200 transition-colors"
                title="Copy email to clipboard"
              >
                Copy
              </button>
            </div>
          </div>
          <span id="copyToast" class="hidden text-[11px] text-emerald-600 font-semibold mt-2 inline-block">
            ✅ Email address copied to clipboard!
          </span>
        </div>

        <!-- Interactive Contact / Song Suggestion Form -->
        <form id="contactForm" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Your Name / Nickname</label>
            <input
              type="text"
              id="senderName"
              required
              placeholder="e.g., Alex / K-Pop Fan"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Your Email (for response)</label>
            <input
              type="email"
              id="senderEmail"
              required
              placeholder="you@example.com"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Topic / Category</label>
            <select
              id="inquiryType"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all text-slate-700"
            >
              <option value="Song Request">🎵 Song Request (Melon/Spotify Track)</option>
              <option value="Grammar Question">📖 Korean Grammar or Vocabulary Question</option>
              <option value="Correction">✏️ Content Correction / Lyric Typo</option>
              <option value="General">💬 General Feedback or Partnership</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Message / Song Details</label>
            <textarea
              id="mailBody"
              rows="5"
              required
              placeholder="Tell us the Artist & Song Title, or your specific Korean grammar question..."
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-4 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-700 hover:to-pink-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-indigo-500/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>✉️</span>
            <span>Send Message to Editorial Team</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    // Copy Email to Clipboard
    const copyBtn = document.getElementById('copyEmailBtn');
    const toast = document.getElementById('copyToast');
    const emailAddress = 'kpophangul.team@gmail.com';

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(emailAddress).then(() => {
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 3000);
        });
      });
    }

    // Submit Form via Mailto Handler
    const form = document.getElementById('contactForm');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('senderName').value.trim();
        const email = document.getElementById('senderEmail').value.trim();
        const type = document.getElementById('inquiryType').value;
        const body = document.getElementById('mailBody').value.trim();

        const fullSubject = encodeURIComponent(`[K-Pop Hangul - ${type}] from ${name}`);
        const fullBody = encodeURIComponent(`From: ${name} (${email})\nTopic: ${type}\n\n[Message]\n${body}`);

        window.location.href = `mailto:${emailAddress}?subject=${fullSubject}&body=${fullBody}`;
      });
    }
  </script>
</BaseLayout>

