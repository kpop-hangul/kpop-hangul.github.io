---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const popularTags = [
  'ChatGPT',
  'Claude',
  '프롬프트',
  '파이썬',
  '업무자동화',
  '라즈베리파이',
  '애드센스',
  '부업',
  '노코드',
  'Astro',
  'GitHubPages',
];
---

<BaseLayout
  title="아티클 실시간 검색 | 앱시안(absian)"
  description="AI 활용법, 개발 팁, 자동화 부업 파이프라인 등 앱시안(absian)의 모든 아티클을 키워드로 실시간 검색하세요."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-semibold mb-3">
        <span>🔍 Instant Search</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        원하는 지식을 검색해 보세요
      </h1>
      <p class="text-slate-600 text-sm">
        제목, 내용, 카테고리, 태그를 입력하시면 230개 이상의 아티클 중에서 실시간으로 찾아드립니다.
      </p>
    </div>

    <!-- Search Input Box -->
    <div class="max-w-3xl mx-auto mb-8">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="searchInput"
          placeholder="검색어 입력 (예: 파이썬, ChatGPT, 애드센스, 노코드...)"
          autofocus
          class="w-full pl-12 pr-12 py-3.5 sm:py-4 text-base sm:text-lg bg-white border-2 border-slate-200 focus:border-blue-500 rounded-2xl shadow-sm focus:outline-none focus:ring-4 focus:ring-blue-500/10 transition-all"
        />
        <button
          type="button"
          id="clearBtn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600"
          title="검색어 지우기"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Quick Tag Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mt-4">
        <span class="text-xs font-semibold text-slate-400 mr-1">추천 키워드:</span>
        {popularTags.map(tag => (
          <button
            type="button"
            class="tag-pill px-3 py-1 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 text-xs font-medium rounded-lg transition-colors"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- AdSense Top Banner -->
    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Search Status Bar -->
    <div class="flex items-center justify-between py-4 border-b border-slate-200 mb-6">
      <div id="searchCount" class="text-sm font-semibold text-slate-700">
        전체 아티클을 불러오는 중...
      </div>
      <div id="searchQueryBadge" class="hidden text-xs text-slate-500">
        검색어: <span class="font-bold text-blue-600" id="queryText"></span>
      </div>
    </div>

    <!-- Results Container -->
    <div id="resultsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-6">
      <!-- Live injected via JavaScript -->
    </div>

    <!-- No Results State -->
    <div id="noResults" class="hidden text-center py-20 bg-white rounded-2xl border border-slate-200/80 my-6 shadow-sm">
      <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
        🔍
      </div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">검색 결과가 없습니다</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">
        입력하신 검색어와 일치하는 글을 찾을 수 없습니다. 다른 검색어나 상단의 추천 키워드를 눌러보세요.
      </p>
    </div>

    <!-- AdSense Bottom Banner -->
    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline define:vars={{ base }}>
    let allPosts = [];
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearBtn');
    const searchCount = document.getElementById('searchCount');
    const searchQueryBadge = document.getElementById('searchQueryBadge');
    const queryText = document.getElementById('queryText');
    const resultsGrid = document.getElementById('resultsGrid');
    const noResults = document.getElementById('noResults');
    const tagPills = document.querySelectorAll('.tag-pill');

    // 1. Fetch JSON index
    async function loadIndex() {
      try {
        const res = await fetch(`${base}/search.json`);
        allPosts = await res.json();
        
        // Check URL params (?q=...)
        const urlParams = new URLSearchParams(window.location.search);
        const initialQuery = urlParams.get('q') || '';
        if (initialQuery) {
          searchInput.value = initialQuery;
          performSearch(initialQuery);
        } else {
          renderResults(allPosts);
          searchCount.textContent = `총 ${allPosts.length}개의 아티클이 등록되어 있습니다.`;
        }
      } catch (err) {
        console.error('Failed to load search index', err);
        searchCount.textContent = '검색 인덱스를 불러오지 못했습니다.';
      }
    }

    // 2. Filter logic
    function performSearch(rawQuery) {
      const q = rawQuery.trim().toLowerCase();

      if (!q) {
        clearBtn.classList.add('hidden');
        searchQueryBadge.classList.add('hidden');
        renderResults(allPosts);
        searchCount.textContent = `총 ${allPosts.length}개의 아티클이 등록되어 있습니다.`;
        return;
      }

      clearBtn.classList.remove('hidden');
      searchQueryBadge.classList.remove('hidden');
      queryText.textContent = `"${rawQuery.trim()}"`;

      const filtered = allPosts.filter(post => {
        const titleMatch = post.title.toLowerCase().includes(q);
        const descMatch = post.description.toLowerCase().includes(q);
        const catMatch = post.category.toLowerCase().includes(q);
        const tagMatch = post.tags.some(t => t.toLowerCase().includes(q));
        return titleMatch || descMatch || catMatch || tagMatch;
      });

      renderResults(filtered);
      searchCount.textContent = `총 ${filtered.length}개의 아티클이 검색되었습니다.`;

      // Update URL without reload
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('q', rawQuery.trim());
      window.history.replaceState({}, '', newUrl);
    }

    // 3. Render cards HTML
    function renderResults(posts) {
      if (posts.length === 0) {
        resultsGrid.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');
      resultsGrid.innerHTML = posts.map(post => {
        const postUrl = `${base}/blog/${post.slug}/`;
        const catUrl = `${base}/categories/${post.categorySlug}/`;
        const tagsHtml = post.tags.slice(0, 3).map(t => `<span class="text-[11px] text-slate-400">#${t}</span>`).join(' ');

        return `
          <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col group">
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center justify-between gap-2 mb-3">
                <a href="${catUrl}" class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors">
                  ${post.category}
                </a>
                <span class="text-xs text-slate-400">${post.readingTime}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
                <a href="${postUrl}">${post.title}</a>
              </h3>
              <p class="text-sm text-slate-600 line-clamp-3 mb-4 flex-1">
                ${post.description}
              </p>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <time>${post.pubDate}</time>
                <a href="${postUrl}" class="text-blue-600 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  읽기 →
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    // Event Listeners
    searchInput.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
      performSearch('');
    });

    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-tag');
        searchInput.value = tag;
        performSearch(tag);
      });
    });

    // Keyboard shortcut (Escape to clear)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.activeElement === searchInput) {
        searchInput.value = '';
        performSearch('');
      }
    });

    // Start loading index
    loadIndex();
  </script>
</BaseLayout>
