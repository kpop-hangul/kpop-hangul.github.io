---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const popularTags = [
  'Beginner',
  'Intermediate',
  'Advanced',
  'NewJeans',
  'aespa',
  'BTS',
  'ILLIT',
  'Melon Top 100',
  'Spotify Daily',
  'Dance & Pop',
  'Grammar Point',
  'Vocabulary',
];
---

<BaseLayout
  title="Search K-Pop Korean Song Lessons | K-Pop Hangul"
  description="Instant search for K-Pop song lessons by song title, Hangul lyrics, artist name, music genre, or Korean difficulty level."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-3">
        <span>🔍 Instant Song Finder</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-3">
        Search K-Pop Korean Lessons
      </h1>
      <p class="text-slate-600 text-sm">
        Type any artist, song title, Hangul word, or grammar pattern to find instant breakdowns.
      </p>
    </div>

    <!-- Search Input Box -->
    <div class="max-w-3xl mx-auto mb-8">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="searchInput"
          placeholder="Search by artist, song, Hangul, or grammar (e.g. aespa, Beginner, 사랑...)"
          autofocus
          class="w-full pl-12 pr-12 py-3.5 sm:py-4 text-base sm:text-lg bg-white border-2 border-slate-200 focus:border-indigo-500 rounded-2xl shadow-xs focus:outline-none focus:ring-4 focus:ring-indigo-500/10 transition-all"
        />
        <button
          type="button"
          id="clearBtn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600"
          title="Clear search input"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Quick Tag Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mt-4">
        <span class="text-xs font-semibold text-slate-400 mr-1">Suggested:</span>
        {popularTags.map(tag => (
          <button
            type="button"
            class="tag-pill px-3 py-1 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 text-xs font-medium rounded-lg transition-colors cursor-pointer"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- AdSense Top Banner -->
    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Search Status Bar -->
    <div class="flex items-center justify-between py-4 border-b border-slate-200 mb-6">
      <div id="searchCount" class="text-sm font-semibold text-slate-700">
        Loading song index...
      </div>
      <div id="searchQueryBadge" class="hidden text-xs text-slate-500">
        Search query: <span class="font-bold text-indigo-600" id="queryText"></span>
      </div>
    </div>

    <!-- Results Container -->
    <div id="resultsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-6">
      <!-- Live injected via JavaScript -->
    </div>

    <!-- No Results State -->
    <div id="noResults" class="hidden text-center py-20 bg-white rounded-3xl border border-slate-200">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">No matching songs found</h3>
      <p class="text-slate-500 text-sm max-w-md mx-auto">
        Try searching with a different artist name, English song title, Hangul keyword, or level.
      </p>
    </div>

    <!-- AdSense Bottom Banner -->
    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline define:vars={{ base }}>
    let allPosts = [];
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearBtn');
    const resultsGrid = document.getElementById('resultsGrid');
    const searchCount = document.getElementById('searchCount');
    const searchQueryBadge = document.getElementById('searchQueryBadge');
    const queryText = document.getElementById('queryText');
    const noResults = document.getElementById('noResults');
    const tagPills = document.querySelectorAll('.tag-pill');

    const diffBadgeStyles = {
      beginner: { label: '🟢 Beginner', bg: 'bg-emerald-50', text: 'text-emerald-700', ring: 'ring-emerald-200' },
      intermediate: { label: '🟡 Intermediate', bg: 'bg-amber-50', text: 'text-amber-700', ring: 'ring-amber-200' },
      advanced: { label: '🔴 Advanced', bg: 'bg-rose-50', text: 'text-rose-700', ring: 'ring-rose-200' },
    };

    fetch(`${base}/search.json`)
      .then(res => res.json())
      .then(data => {
        allPosts = data;
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q') || '';
        if (q) {
          searchInput.value = q;
          renderResults(filterPosts(q), q);
        } else {
          renderResults(allPosts, '');
        }
      })
      .catch(err => {
        searchCount.textContent = 'Failed to load songs. Please refresh.';
      });

    function filterPosts(q) {
      const term = q.trim().toLowerCase();
      if (!term) return allPosts;

      return allPosts.filter(p => {
        const titleMatch = p.title.toLowerCase().includes(term);
        const descMatch = p.description.toLowerCase().includes(term);
        const artistMatch = (p.artist || '').toLowerCase().includes(term);
        const songMatch = (p.songTitle || '').toLowerCase().includes(term);
        const hangulMatch = (p.hangulTitle || '').toLowerCase().includes(term);
        const diffMatch = (p.difficulty || '').toLowerCase().includes(term);
        const genreMatch = (p.genre || '').toLowerCase().includes(term);
        const tagMatch = (p.tags || []).some(t => t.toLowerCase().includes(term));
        return titleMatch || descMatch || artistMatch || songMatch || hangulMatch || diffMatch || genreMatch || tagMatch;
      });
    }

    function renderResults(posts, query) {
      if (query.trim()) {
        clearBtn.classList.remove('hidden');
        searchQueryBadge.classList.remove('hidden');
        queryText.textContent = query;
        searchCount.textContent = `Found ${posts.length} lesson${posts.length !== 1 ? 's' : ''}`;
      } else {
        clearBtn.classList.add('hidden');
        searchQueryBadge.classList.add('hidden');
        searchCount.textContent = `Showing all ${posts.length} Korean song lessons`;
      }

      if (posts.length === 0) {
        resultsGrid.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');
      resultsGrid.innerHTML = posts.map(p => {
        const diffKey = (p.difficultySlug || 'beginner').toLowerCase();
        const badge = diffBadgeStyles[diffKey] || diffBadgeStyles.beginner;
        const rankBadge = p.chartRank ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900">🏆 #${p.chartRank}</span>` : '';

        return `
          <article class="bg-white rounded-2xl border border-slate-200/90 p-6 shadow-xs hover:shadow-md hover:border-indigo-300 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ring-1 ${badge.bg} ${badge.text} ${badge.ring}">
                    ${badge.label}
                  </span>
                  <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">
                    ${p.genre || 'Dance & Pop'}
                  </span>
                </div>
                ${rankBadge}
              </div>

              <div class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-1">
                ${p.artist || ''} ${p.hangulTitle ? `<span class="text-slate-400 font-normal">(${p.hangulTitle})</span>` : ''}
              </div>

              <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-2 mb-2">
                <a href="${base}/blog/${p.slug}/">${p.title}</a>
              </h3>

              <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">
                ${p.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span>${p.pubDate}</span>
              <a href="${base}/blog/${p.slug}/" class="text-indigo-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Learn Song →
              </a>
            </div>
          </article>
        `;
      }).join('');
    }

    searchInput.addEventListener('input', (e) => {
      const q = e.target.value;
      renderResults(filterPosts(q), q);
    });

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
      renderResults(allPosts, '');
    });

    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-tag');
        searchInput.value = tag;
        renderResults(filterPosts(tag), tag);
      });
    });
  </script>
</BaseLayout>
