---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getDynamicCategories } from '../../utils/categories';
import { getCategorySlug } from '../../utils/slug';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { allCategories, totalPosts } = await getDynamicCategories(100);

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// 각 카테고리별 최신 글 3개 추출
const categoriesWithRecentPosts = allCategories.map(cat => {
  const posts = allPosts
    .filter(p => getCategorySlug(p.data.category) === cat.slug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
  return {
    ...cat,
    recentPosts: posts,
  };
});
---

<BaseLayout
  title="전체 카테고리 | 앱시안(absian)"
  description="AI, 개발 테크, 부업 등 앱시안(absian)의 모든 주제별 카테고리 및 아티클 허브입니다."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
        <span>📑 Topics Hub</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        카테고리 허브
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        총 {allCategories.length}개의 주제에 {totalPosts}편의 전문 테크 & 수익화 가이드가 연재 중입니다.
      </p>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
      {categoriesWithRecentPosts.map((cat, idx) => (
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs hover:shadow-md hover:border-blue-300 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-50 text-blue-700 text-xs font-bold border border-blue-100">
                #{idx + 1}
              </span>
              <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">
                {cat.count}편
              </span>
            </div>

            <h2 class="text-xl font-bold text-slate-900 mb-2">
              <a href={cat.href} class="hover:text-blue-600 transition-colors">
                {cat.name}
              </a>
            </h2>

            <!-- Recent 3 Articles in Category -->
            <div class="mt-4 pt-4 border-t border-slate-100 space-y-2.5">
              <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">최신 아티클</div>
              {cat.recentPosts.map(post => (
                <a
                  href={`${base}/blog/${post.slug}/`}
                  class="block text-xs text-slate-600 hover:text-blue-600 transition-colors line-clamp-1 group"
                >
                  <span class="text-slate-300 group-hover:text-blue-400 mr-1.5">•</span>
                  {post.data.title}
                </a>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100">
            <a
              href={cat.href}
              class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 hover:gap-1.5 transition-all"
            >
              <span>{cat.name} 전체 글 둘러보기</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <AdSense slotId="3456789012" type="multiplex" />
    </div>
  </div>
</BaseLayout>
