---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import AdSense from '../../components/AdSense.astro';
import { getCategorySlug, getCategoryName } from '../../utils/slug';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const knownCategories = ['beginner', 'intermediate', 'advanced', 'dance-pop', 'rnb-soul', 'hip-hop', 'ballad-ost'];
  const postCategories = allPosts.map(p => getCategorySlug(p.data.category));
  const uniqueCategorySlugs = [...new Set([...knownCategories, ...postCategories])];

  return uniqueCategorySlugs.map(slug => {
    const filteredPosts = allPosts
      .filter(post => getCategorySlug(post.data.category) === slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    const firstRawName = filteredPosts[0]?.data.category;

    return {
      params: { category: slug },
      props: {
        categorySlug: slug,
        categoryName: getCategoryName(slug, firstRawName),
        posts: filteredPosts,
      },
    };
  });
}

const { categorySlug, categoryName, posts } = Astro.props;
---

<BaseLayout
  title={`${categoryName} Lessons | K-Pop Hangul`}
  description={`Browse all Korean language learning lessons and song breakdowns for ${categoryName}.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="text-xs font-semibold text-indigo-600 uppercase tracking-wide mb-1">Category & Tier</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">{categoryName}</h1>
      <p class="text-slate-600 text-sm mt-2">Found {posts.length} {posts.length === 1 ? 'song lesson' : 'song lessons'} in this category.</p>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {posts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            readingTime={post.data.readingTime}
            difficulty={post.data.difficulty}
            genre={post.data.genre}
            artist={post.data.artist}
            songTitle={post.data.songTitle}
            hangulTitle={post.data.hangulTitle}
            chartRank={post.data.chartRank}
            chartSource={post.data.chartSource}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 shadow-xs">
        <div class="text-4xl mb-2">🎵</div>
        <p class="text-slate-700 font-bold text-base mb-1">No songs in this category yet</p>
        <p class="text-slate-400 text-xs">New lessons are generated daily from Melon & Spotify top charts!</p>
      </div>
    )}

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>
</BaseLayout>
