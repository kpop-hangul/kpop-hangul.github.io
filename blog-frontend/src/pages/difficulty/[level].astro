---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getDifficultySlug, getDifficultyName } from '../../utils/slug';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);

  const levels = ['beginner', 'intermediate', 'advanced'];

  return levels.map(slug => {
    const filtered = allPosts
      .filter(p => getDifficultySlug(p.data.difficulty || p.data.category) === slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { level: slug },
      props: {
        levelSlug: slug,
        levelName: getDifficultyName(slug),
        posts: filtered,
      },
    };
  });
}

const { levelSlug, levelName, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const levelBadges: Record<string, string> = {
  beginner: '🟢 Beginner (Level 1)',
  intermediate: '🟡 Intermediate (Level 2)',
  advanced: '🔴 Advanced (Level 3)',
};
---

<BaseLayout
  title={`${levelName} K-Pop Songs | Learn Korean Lessons`}
  description={`Master Korean with ${levelName} K-Pop songs from Melon and Spotify. Explore line-by-line Hangul lyrics, Romanization, vocabulary, and grammar breakdowns.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-indigo-600 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/difficulty/`} class="hover:text-indigo-600 transition-colors">By Level</a>
      <span>/</span>
      <span class="text-indigo-600 font-semibold">{levelName}</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 mb-2">
        Proficiency Tier
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        {levelBadges[levelSlug] || levelName}
      </h1>
      <p class="text-slate-600 text-sm mt-2 max-w-2xl">
        Showing {posts.length} Korean language song breakdown{posts.length !== 1 ? 's' : ''} curated for this difficulty level.
      </p>
    </div>

    <!-- Song List Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {posts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            difficulty={post.data.difficulty}
            genre={post.data.genre}
            artist={post.data.artist}
            songTitle={post.data.songTitle}
            hangulTitle={post.data.hangulTitle}
            chartRank={post.data.chartRank}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-3xl border border-slate-200">
        <div class="text-4xl mb-3">🎵</div>
        <h3 class="text-lg font-bold text-slate-800 mb-1">New Lessons Coming Soon!</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto">
          Our daily automated pipeline writes 3 new songs every day from Melon & Spotify top charts. Check back tomorrow!
        </p>
      </div>
    )}
  </div>
</BaseLayout>
