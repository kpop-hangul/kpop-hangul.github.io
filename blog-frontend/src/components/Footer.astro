---
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-slate-950 text-slate-300 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Site Info -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 text-white font-black text-base flex items-center justify-center shadow-xs">
            🎵
          </div>
          <span class="font-bold text-white text-base tracking-tight">{siteConfig.site.name}</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed mb-4">
          Find your starting point with our English-language Hangul guide, letter charts, and syllable diagrams.
        </p>
        <p class="text-xs text-slate-500">
          Read at your own pace and return to the alphabet reference whenever you need it.
        </p>
      </div>

      <!-- Korean Levels & Taxonomies -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">By Difficulty Level</h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href={`${base}/start/`} class="hover:text-white transition-colors text-indigo-300 font-semibold">Start here: Hangul reading path</a></li>
          <li><a href={`${base}/difficulty/beginner/`} class="hover:text-indigo-400 transition-colors">🟢 Beginner (Level 1)</a></li>
          <li><a href={`${base}/difficulty/intermediate/`} class="hover:text-amber-400 transition-colors">🟡 Intermediate (Level 2)</a></li>
          <li><a href={`${base}/difficulty/advanced/`} class="hover:text-rose-400 transition-colors">🔴 Advanced (Level 3)</a></li>
          <li><a href={`${base}/hangul/`} class="hover:text-white transition-colors text-indigo-400 font-medium">📖 Hangul 101 Primer</a></li>
          <li><a href={`${base}/artists/`} class="hover:text-white transition-colors">🎤 Artists Directory</a></li>
        </ul>
      </div>

      <!-- Legal & Policies -->
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3">About & Guidelines</h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href={`${base}/about/`} class="hover:text-white transition-colors">About K-Pop Hangul</a></li>
          <li><a href={`${base}/genres/`} class="hover:text-white transition-colors">All Music Genres</a></li>
          <li><a href={`${base}/privacy-policy/`} class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href={`${base}/terms/`} class="hover:text-white transition-colors">Terms of Service & Fair Use</a></li>
          <li><a href={`${base}/contact/`} class="hover:text-white transition-colors">Contact Editorial Team</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 mt-8 border-t border-slate-800/80 text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© {currentYear} {siteConfig.site.shortName}. All educational materials created for language learning.</p>
      <p class="text-slate-500 text-center sm:text-right">
        Song lyrics are used under Fair Use for educational translation and language study purposes.
      </p>
    </div>
  </div>
</footer>
