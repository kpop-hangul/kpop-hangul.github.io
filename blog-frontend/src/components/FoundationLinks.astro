---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside aria-label="Hangul learning help" class="my-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-5 sm:p-6">
  <p class="font-bold text-slate-900">Need the alphabet first?</p>
  <p class="mt-1 text-sm text-slate-600">Choose a starting point or jump back to a section of the Hangul guide.</p>
  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-indigo-700">
    <li><a href={`${base}/start/`} class="underline underline-offset-4 hover:text-indigo-900">Start here →</a></li>
    <li><a href={`${base}/hangul/#consonants`} class="underline underline-offset-4 hover:text-indigo-900">Consonant chart</a></li>
    <li><a href={`${base}/hangul/#vowels`} class="underline underline-offset-4 hover:text-indigo-900">Vowel chart</a></li>
    <li><a href={`${base}/hangul/#blocks`} class="underline underline-offset-4 hover:text-indigo-900">Syllable blocks</a></li>
  </ul>
</aside>
