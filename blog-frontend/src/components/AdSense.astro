---
import siteConfig from '../config/site';

export interface Props {
  slotId?: string;
  type?: 'top-banner' | 'in-article' | 'bottom-banner' | 'sidebar' | 'multiplex';
  format?: 'auto' | 'fluid' | 'rectangle';
  className?: string;
}

const {
  slotId = '',
  type = 'in-article',
  format = 'auto',
  className = '',
} = Astro.props;

// AdSense configuration check
const publisherId = import.meta.env.PUBLIC_ADSENSE_ID || siteConfig.monetization?.adsenseClientId || '';
const dummyIds = ['1234567890', '2345678901', '3456789012', '4567890123', '5678901234'];
const isValidSlot = Boolean(slotId && !dummyIds.includes(slotId));
const isDev = import.meta.env.DEV;
---

{isDev && (publisherId || slotId) ? (
  <div class={`ad-slot-container my-6 ${className}`} data-ad-slot={slotId}>
    <span class="ad-label text-[10px] text-slate-400 uppercase tracking-widest block text-center mb-1">ADVERTISEMENT PREVIEW (DEV)</span>
    <div class="flex flex-col items-center justify-center p-4 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-500 text-xs border border-dashed border-slate-300 dark:border-slate-700">
      <div class="flex items-center gap-2 mb-1">
        <span class="font-semibold text-slate-700 dark:text-slate-300">Google AdSense Slot [{type}]</span>
      </div>
      <p class="text-[11px] text-slate-400">Client: {publisherId || 'None'} | Slot: {slotId || 'Auto'}</p>
    </div>
  </div>
) : (!isDev && publisherId && isValidSlot) ? (
  <div class={`ad-slot-container my-6 ${className}`} data-ad-slot={slotId}>
    <span class="ad-label text-[10px] text-slate-400 uppercase tracking-widest block text-center mb-1">ADVERTISEMENT</span>
    <ins class="adsbygoogle"
         style="display:block; text-align:center;"
         data-ad-layout={type === 'in-article' ? 'in-article' : undefined}
         data-ad-format={format}
         data-ad-client={publisherId}
         data-ad-slot={slotId}
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : null}

<style>
  .ad-slot-container:empty {
    display: none !important;
  }
</style>


