---
import { getCategorySlug } from '../utils/slug';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  readingTime?: string;
  heroImage?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  slug,
  category,
  readingTime = '5 min read',
  heroImage = '/images/default-hero.svg',
  tags = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col group">
  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-center justify-between gap-2 mb-3">
      <a
        href={`${base}/categories/${categorySlug}/`}
        class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors"
      >
        {category}
      </a>
      <span class="text-xs text-slate-400">{readingTime}</span>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
      <a href={`${base}/blog/${slug}/`}>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 line-clamp-3 mb-4 flex-1">
      {description}
    </p>

    <!-- Footer Meta -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <a
        href={`${base}/blog/${slug}/`}
        class="text-blue-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
      >
        읽기 →
      </a>
    </div>
  </div>
</article>
