---
import siteConfig from '../config/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  canonicalURL?: string;
  faqs?: Array<{ question: string; answer: string }>;
  tags?: string[];
  gaId?: string;
  googleVerification?: string;
  naverVerification?: string;
}

const {
  title,
  description,
  image = '/images/default-hero.svg',
  article = false,
  pubDate,
  updatedDate,
  author = siteConfig.site.author || 'K-Pop Hangul Team',
  canonicalURL = Astro.url.href,
  faqs,
  tags = [],
  gaId = siteConfig.seo.gaId || import.meta.env.PUBLIC_GA_ID || '',
  googleVerification = siteConfig.seo.googleVerification || import.meta.env.PUBLIC_GOOGLE_VERIFICATION || '',
  naverVerification = siteConfig.seo.naverVerification || import.meta.env.PUBLIC_NAVER_VERIFICATION || '',
} = Astro.props;

const siteName = siteConfig.site.shortName || 'K-Pop Hangul';
let formattedTitle = title;

if (!title.includes(siteName)) {
  if (title.length + siteName.length + 3 <= 60) {
    formattedTitle = `${title} | ${siteName}`;
  } else {
    formattedTitle = title;
  }
}

const articleSlug = Astro.params.slug;
const resolvedImage = (article && articleSlug && (image === '/images/default-hero.svg' || !image))
  ? `/og/${articleSlug}.svg`
  : image;

const siteUrl = siteConfig.site.url || Astro.site?.href || 'https://kpop-hangul.github.io';
const absoluteImageUrl = new URL(resolvedImage, siteUrl).href;

// Structured Data: Article / BlogPosting
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  'headline': title,
  'description': description,
  'image': [absoluteImageUrl],
  'datePublished': pubDate ? pubDate.toISOString() : new Date().toISOString(),
  'dateModified': updatedDate ? updatedDate.toISOString() : (pubDate ? pubDate.toISOString() : new Date().toISOString()),
  'author': {
    '@type': 'Organization',
    'name': author,
  },
  'publisher': {
    '@type': 'Organization',
    'name': siteName,
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/favicon.png', siteUrl).href,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  'keywords': tags.join(', '),
  'inLanguage': 'en',
  'educationalLevel': 'Beginner, Intermediate, Advanced',
} : null;

// Structured Data: FAQPage
const faqSchema = (faqs && faqs.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer,
    },
  })),
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<!-- Verification Tags -->
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{naverVerification && <meta name="naver-site-verification" content={naverVerification} />}

<!-- Google AdSense Official Script & Account Verification -->
{siteConfig.monetization?.adsenseClientId && (
  <>
    <meta name="google-adsense-account" content={siteConfig.monetization.adsenseClientId} />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.monetization.adsenseClientId}`}
      crossorigin="anonymous"
    ></script>
  </>
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImageUrl} />

<!-- JSON-LD Structured Data -->
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<!-- Google Analytics (GA4) -->
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
