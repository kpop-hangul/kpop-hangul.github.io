---
export interface Props {
  title?: string;
  subtitle?: string;
  downloadUrl?: string;
  badge?: string;
}

const {
  title = "[무료 배포] 2026 옵시디언 + AI 스타터 볼트 패키지",
  subtitle = "더 이상 플러그인과 단축키 설정으로 헤매지 마세요. 다운받아 열기만 하면 즉시 작동하는 나만의 오프라인 AI 제2의 뇌 환경입니다.",
  downloadUrl = "https://absian.gumroad.com/l/obsidian-ai-starter-vault",
  badge = "🎁 2026 실전 생산성 킷",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 p-6 sm:p-8 text-white shadow-xl my-10 border border-indigo-500/40">
  <!-- Background Glow Effect -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-semibold mb-4 border border-indigo-500/30">
      <span>{badge}</span>
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">
      {title}
    </h3>
    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-2xl mb-6">
      {subtitle}
    </p>

    <!-- Highlights Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 text-xs text-slate-200">
      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
        <span class="text-base flex-shrink-0">🖥️</span>
        <div>
          <strong class="text-white block font-semibold">Mac·Windows·Linux 완벽 지원</strong>
          <span class="text-slate-400 text-[11px]">iCloud 모바일 동기화 및 OS별 원클릭 셋업 가이드</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
        <span class="text-base flex-shrink-0">⚡</span>
        <div>
          <strong class="text-white block font-semibold">사전 최적화 플러그인 8종</strong>
          <span class="text-slate-400 text-[11px]">Smart Connections, Dataview, Omnisearch 완비</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
        <span class="text-base flex-shrink-0">📝</span>
        <div>
          <strong class="text-white block font-semibold">AI 프롬프트 템플릿 4종</strong>
          <span class="text-slate-400 text-[11px]">AI 독서록, 아이디어 발상, 블로그 초안, 데일리 회고</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-xs">
        <span class="text-base flex-shrink-0">🔒</span>
        <div>
          <strong class="text-white block font-semibold">100% 오프라인 & 무료 연동</strong>
          <span class="text-slate-400 text-[11px]">Ollama 로컬 LLM으로 API 비용 0원 평생 구동</span>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
      <a
        href={downloadUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold text-xs sm:text-sm shadow-lg shadow-indigo-500/25 transition-all transform hover:-translate-y-0.5 cursor-pointer"
      >
        <span>📥 스타터 볼트 패키지 다운로드</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <a
        href={`${base}/blog/2026-09-02-obsidian-ai-starter-vault-workflow/`}
        class="w-full sm:w-auto inline-flex items-center justify-center px-4 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 hover:text-white font-medium text-xs transition-colors border border-white/10"
      >
        📖 실전 사용 매뉴얼 읽기
      </a>
    </div>

    <p class="text-[11px] text-slate-400 mt-3 text-center sm:text-left">
      * 결제창에서 <strong class="text-indigo-300">0원($0)</strong>을 입력하시면 무료로 다운로드되며, 커피 한 잔의 자율 후원도 가능합니다.
    </p>
  </div>
</div>
