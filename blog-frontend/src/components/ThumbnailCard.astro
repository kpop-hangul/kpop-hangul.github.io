---
import { getCategorySlug } from '../utils/slug';

export interface Props {
  title: string;
  summary?: string;
  description?: string;
  slug: string;
  category: string;
  pubDate: Date;
  readingTime?: string;
  heroImage?: string;
}

const {
  title,
  summary,
  description = '',
  slug,
  category,
  pubDate,
  readingTime = '5 min',
  heroImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);

const thumbnailSrc = heroImage && heroImage !== '/images/default-hero.svg'
  ? heroImage
  : `${base}/og/${slug}.svg`;

const displaySummary = summary || description || '실전 노하우와 유용한 팁을 담은 심층 가이드입니다.';
---

<article class="group bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-lg hover:border-blue-400 transition-all duration-300 flex flex-col">
  <!-- Thumbnail Link & Image: 카드 썸네일 자체에 제목이 크게 인쇄되어 있음 -->
  <a href={`${base}/blog/${slug}/`} class="relative block overflow-hidden aspect-[1200/630] bg-slate-950">
    <img
      src={thumbnailSrc}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <!-- Floating category pill overlay -->
    <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 text-[11px] font-semibold bg-slate-900/85 backdrop-blur-md text-blue-300 rounded-full border border-white/10 shadow-xs">
      {category}
    </span>
  </a>

  <!-- Compact Content Info: 글 제목 중복 대신 '글 내용 서론/요약 내용' 노출 -->
  <div class="p-4 flex-1 flex flex-col justify-between">
    <a href={`${base}/blog/${slug}/`} class="block group/text mb-3">
      <p class="text-xs sm:text-sm text-slate-600 group-hover/text:text-blue-600 transition-colors line-clamp-3 leading-relaxed">
        {displaySummary}
      </p>
    </a>

    <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2.5 border-t border-slate-100">
      <span>{formattedDate}</span>
      <a
        href={`${base}/blog/${slug}/`}
        class="flex items-center gap-1 text-blue-600 font-medium hover:underline group-hover:translate-x-0.5 transition-transform"
      >
        <span>읽어보기</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
