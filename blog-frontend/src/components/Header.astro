---
import { getDifficultyStats, getGenreStats } from '../utils/kpop';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const difficulties = await getDifficultyStats();
const genres = await getGenreStats();
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-indigo-100/80 transition-all duration-200 shadow-2xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center text-white font-black text-lg shadow-sm group-hover:scale-105 transition-transform">
        🎵
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-slate-900 text-lg tracking-tight group-hover:text-indigo-600 transition-colors flex items-center gap-1.5">
          {siteConfig.site.shortName}
          <span class="text-[10px] px-1.5 py-0.5 bg-indigo-50 text-indigo-600 rounded font-semibold border border-indigo-200/50">한글</span>
        </span>
        <span class="text-[10px] text-slate-500 -mt-0.5 font-medium tracking-wide">Learn Korean with K-Pop Hits</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
      <a
        href={`${base}/`}
        class="px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors"
      >
        Home
      </a>
      <a
        href={`${base}/blog/`}
        class="px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors"
      >
        All Songs
      </a>
      <a
        href={`${base}/hangul/`}
        class="px-2.5 py-1.5 rounded-lg text-indigo-600 font-semibold hover:bg-indigo-50 transition-colors flex items-center gap-1"
      >
        <span>📖 Hangul 101</span>
      </a>
      <a
        href={`${base}/gallery/`}
        class="px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors"
      >
        Archive
      </a>

      <!-- 1. Difficulty Dropdown -->
      <div class="relative group">
        <a
          href={`${base}/difficulty/`}
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors cursor-pointer"
        >
          <span>By Level</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Difficulty Dropdown Menu -->
        <div class="absolute top-full left-0 pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <div class="bg-white rounded-xl shadow-xl border border-slate-200/90 py-2 overflow-hidden ring-1 ring-black/5">
            <div class="px-3.5 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-100">
              Korean Difficulty Levels
            </div>
            <div class="py-1">
              {difficulties.map(d => (
                <a
                  href={d.href}
                  class="flex items-center justify-between px-3.5 py-2 text-xs text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                >
                  <span class="font-medium">{d.badge}</span>
                  <span class="text-[10px] bg-slate-100 text-slate-500 rounded-full px-2 py-0.5 font-medium ml-2">
                    {d.count} songs
                  </span>
                </a>
              ))}
            </div>
            <div class="pt-1 border-t border-slate-100">
              <a
                href={`${base}/difficulty/`}
                class="block px-3.5 py-2 text-[11px] font-semibold text-indigo-600 hover:bg-indigo-50 transition-colors"
              >
                View Level Guide & Hub →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Genres Dropdown -->
      <div class="relative group">
        <a
          href={`${base}/genres/`}
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors cursor-pointer"
        >
          <span>By Genre</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Genres Dropdown Menu -->
        <div class="absolute top-full left-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <div class="bg-white rounded-xl shadow-xl border border-slate-200/90 py-2 overflow-hidden ring-1 ring-black/5">
            <div class="px-3.5 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-100">
              Music Genres
            </div>
            <div class="max-h-64 overflow-y-auto py-1">
              {genres.map(g => (
                <a
                  href={g.href}
                  class="flex items-center justify-between px-3.5 py-2 text-xs text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                >
                  <span class="truncate">{g.name}</span>
                  <span class="text-[10px] bg-slate-100 text-slate-500 rounded-full px-2 py-0.5 font-medium ml-2">
                    {g.count}
                  </span>
                </a>
              ))}
            </div>
            <div class="pt-1 border-t border-slate-100">
              <a
                href={`${base}/genres/`}
                class="block px-3.5 py-2 text-[11px] font-semibold text-indigo-600 hover:bg-indigo-50 transition-colors"
              >
                All Genres Hub →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Artists Hub -->
      <a
        href={`${base}/artists/`}
        class="px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors"
      >
        Artists Hub
      </a>

      <a
        href={`${base}/about/`}
        class="px-2.5 py-1.5 rounded-lg hover:text-indigo-600 hover:bg-slate-100/80 transition-colors text-slate-500 text-xs"
      >
        About
      </a>
    </nav>

    <!-- Right Action (Search / RSS / Mobile Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Button (Quick link to Search Page) -->
      <a
        href={`${base}/search/`}
        class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100/80 hover:bg-indigo-50 hover:text-indigo-600 border border-slate-200/80 rounded-xl transition-all shadow-xs group"
        title="Search songs, lyrics & grammar (Cmd + K)"
      >
        <svg class="w-4 h-4 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search Song</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono font-semibold text-slate-400 bg-white border border-slate-200 rounded shadow-2xs">
          ⌘K
        </kbd>
      </a>

      <!-- RSS Feed -->
      <a
        href={`${base}/rss.xml`}
        class="p-2 text-slate-400 hover:text-amber-500 hover:bg-slate-100 rounded-lg transition-colors"
        title="Subscribe to Daily RSS Feed"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-lg transition-colors"
        aria-label="Open mobile navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobile-menu-overlay" class="hidden md:hidden fixed inset-0 top-16 bg-slate-950/40 backdrop-blur-xs z-30 transition-opacity"></div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden md:hidden relative z-40 border-t border-slate-200/80 bg-white/98 backdrop-blur-md px-4 py-4 space-y-2 shadow-xl">
    <a href={`${base}/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">Home</a>
    <a href={`${base}/blog/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">All Songs & Lessons</a>
    <a href={`${base}/hangul/`} class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-bold text-indigo-600 bg-indigo-50/70 hover:bg-indigo-100/70">
      <span>📖 Hangul 101 Primer</span>
      <span class="text-[10px] bg-indigo-200/60 text-indigo-800 rounded px-1.5 py-0.5">Alphabet</span>
    </a>
    <a href={`${base}/gallery/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">Visual Song Archive</a>
    <a href={`${base}/artists/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">Artists Hub</a>
    <a href={`${base}/search/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">Search Korean Lessons</a>
    
    <div class="pt-3 pb-1 border-t border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider px-3">
      By Difficulty Level
    </div>
    {difficulties.map(d => (
      <a href={d.href} class="flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-600">
        <span>{d.badge}</span>
        <span class="text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">{d.count}</span>
      </a>
    ))}

    <div class="pt-3 pb-1 border-t border-slate-100 text-[11px] font-semibold text-slate-400 uppercase tracking-wider px-3">
      By Music Genre
    </div>
    {genres.map(g => (
      <a href={g.href} class="flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600">
        <span>{g.name}</span>
        <span class="text-[10px] text-slate-400">{g.count}</span>
      </a>
    ))}

    <div class="pt-3 border-t border-slate-100 space-y-1">
      <a href={`${base}/about/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">About K-Pop Hangul</a>
      <a href={`${base}/contact/`} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Contact & Song Requests</a>
    </div>
  </div>
</header>

<script is:inline define:vars={{ base }}>
  // Mobile Hamburger & Backdrop Overlay Toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  const mobileOverlay = document.getElementById('mobile-menu-overlay');

  function closeMobileMenu() {
    if (mobileDrawer) mobileDrawer.classList.add('hidden');
    if (mobileOverlay) mobileOverlay.classList.add('hidden');
  }

  function toggleMobileMenu() {
    if (mobileDrawer && mobileOverlay) {
      const isHidden = mobileDrawer.classList.toggle('hidden');
      if (isHidden) {
        mobileOverlay.classList.add('hidden');
      } else {
        mobileOverlay.classList.remove('hidden');
      }
    }
  }

  if (mobileToggle) {
    mobileToggle.addEventListener('click', toggleMobileMenu);
  }
  if (mobileOverlay) {
    mobileOverlay.addEventListener('click', closeMobileMenu);
  }

  // Global Shortcut Cmd+K / Ctrl+K to navigate to /search/
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (!window.location.pathname.includes('/search')) {
        window.location.href = `${base}/search/`;
      } else {
        const input = document.getElementById('searchInput');
        if (input) input.focus();
      }
    }
  });
</script>

