---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getDifficultySlug, getGenreSlug, getArtistSlug, getDifficultyName } from '../utils/slug';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  frontmatter: CollectionEntry<'blog'>['data'];
  headings: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: { title: string; slug: string; category?: string } | null;
  nextPost?: { title: string; slug: string; category?: string } | null;
}

const { frontmatter, headings, prevPost, nextPost } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category = 'Beginner (Level 1)',
  difficulty = 'Beginner',
  genre = 'Dance & Pop',
  artist = 'Various Artists',
  songTitle,
  hangulTitle,
  chartRank,
  chartSource = 'Melon Top 100',
  tags = [],
  author = 'K-Pop Hangul Team',
  readingTime = '6 min read',
  faqs = [],
} = frontmatter;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const diffSlug = getDifficultySlug(difficulty || category);
const genreSlug = getGenreSlug(genre);
const artistSlug = getArtistSlug(artist);

const diffBadges: Record<string, { label: string; bg: string; text: string; ring: string }> = {
  beginner: { label: '🟢 Beginner (Level 1)', bg: 'bg-emerald-50', text: 'text-emerald-700', ring: 'ring-emerald-200' },
  intermediate: { label: '🟡 Intermediate (Level 2)', bg: 'bg-amber-50', text: 'text-amber-700', ring: 'ring-amber-200' },
  advanced: { label: '🔴 Advanced (Level 3)', bg: 'bg-rose-50', text: 'text-rose-700', ring: 'ring-rose-200' },
};
const badge = diffBadges[diffSlug] || diffBadges.beginner;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  faqs={faqs}
  tags={tags}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium flex-wrap">
      <a href={`${base}/`} class="hover:text-indigo-600 transition-colors">Home</a>
      <span>/</span>
      <a href={`${base}/blog/`} class="hover:text-indigo-600 transition-colors">Songs</a>
      <span>/</span>
      <a href={`${base}/difficulty/${diffSlug}/`} class="hover:text-indigo-600 transition-colors">{getDifficultyName(diffSlug)}</a>
      <span>/</span>
      <span class="text-indigo-600 font-semibold truncate max-w-[200px]">{songTitle || title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-8">
      <!-- Badges Row -->
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <a
          href={`${base}/difficulty/${diffSlug}/`}
          class={`px-3 py-1 text-xs font-bold rounded-full ring-1 ${badge.bg} ${badge.text} ${badge.ring} hover:opacity-80 transition-opacity`}
        >
          {badge.label}
        </a>

        <a
          href={`${base}/genres/${genreSlug}/`}
          class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-full hover:bg-slate-200 transition-colors"
        >
          {genre}
        </a>

        {chartRank && (
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
            🏆 {chartSource} #{chartRank}
          </span>
        )}

        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500">{readingTime}</span>
      </div>

      <!-- Artist & Hangul Title Subheading -->
      <div class="flex items-center gap-2 text-sm font-bold text-indigo-600 mb-2">
        <a href={`${base}/artists/${artistSlug}/`} class="hover:underline">
          {artist}
        </a>
        {hangulTitle && (
          <span class="text-slate-500 font-normal">({hangulTitle})</span>
        )}
      </div>

      <!-- Main Title -->
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <!-- Description -->
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
        {description}
      </p>

      <!-- Author & Date Info -->
      <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200/80 text-xs text-slate-500">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white font-bold text-sm flex items-center justify-center">
            🎵
          </div>
          <div>
            <p class="font-bold text-slate-800">{author}</p>
            <p>Published: {formattedDate} {updatedDate && `(Updated: ${new Intl.DateTimeFormat('en-US').format(updatedDate)})`}</p>
          </div>
        </div>

        <a
          href={`${base}/artists/${artistSlug}/`}
          class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 hidden sm:inline"
        >
          More by {artist} →
        </a>
      </div>
    </header>

    <!-- Top AdSense Slot -->
    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Table of Contents -->
    <TableOfContents headings={headings} />

    <!-- Article Markdown Content -->
    <div id="article-content" class="prose prose-slate prose-indigo prose-lg max-w-none bg-white p-6 sm:p-10 rounded-3xl border border-slate-200/80 shadow-xs leading-relaxed">
      <slot />
    </div>

    <!-- Toast Notification for Micro-interactions -->
    <div id="lessonToast" class="fixed bottom-12 sm:bottom-6 right-6 z-50 transform translate-y-12 opacity-0 transition-all duration-300 pointer-events-none bg-slate-950 text-white px-4 py-3 rounded-2xl shadow-2xl text-xs font-semibold flex items-center gap-2.5 border border-slate-800">
      <span id="toastIcon" class="text-base">📋</span>
      <span id="toastMsg">Copied to clipboard!</span>
    </div>

    <!-- Mid/In-Article AdSense Slot -->
    <AdSense slotId="2345678901" type="in-article" />

    <!-- FAQ Accordion Section -->
    {faqs && faqs.length > 0 && (
      <section class="my-10 p-6 sm:p-8 bg-slate-50 rounded-3xl border border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span>❓ Frequently Asked Questions (FAQ)</span>
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
              <h3 class="font-bold text-slate-900 text-sm mb-2">{faq.question}</h3>
              <p class="text-slate-600 text-xs leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Prev / Next Lesson Navigation -->
    {(prevPost || nextPost) && (
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-10 pt-8 border-t border-slate-200">
        {prevPost ? (
          <a
            href={`${base}/blog/${prevPost.slug}/`}
            class="p-4 rounded-2xl border border-slate-200 hover:border-indigo-400 bg-white shadow-2xs transition-all group"
          >
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">← Previous Song</span>
            <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 line-clamp-1">{prevPost.title}</span>
          </a>
        ) : <div />}

        {nextPost && (
          <a
            href={`${base}/blog/${nextPost.slug}/`}
            class="p-4 rounded-2xl border border-slate-200 hover:border-indigo-400 bg-white shadow-2xs transition-all group text-right sm:text-right"
          >
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Next Song →</span>
            <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 line-clamp-1">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}

    <!-- Bottom AdSense Slot -->
    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <!-- Interactive Pedagogical Script: Web TTS, Robust Lyric Copy & Flashcard Recall -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const article = document.getElementById('article-content');
      if (!article) return;

      const toast = document.getElementById('lessonToast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      function showToast(msg, icon = '📋') {
        if (!toast) return;
        toastMsg.textContent = msg;
        toastIcon.textContent = icon;
        toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
        }, 3000);
      }

      function speakKorean(text, btnElement) {
        if (!('speechSynthesis' in window)) {
          alert('SpeechSynthesis is not supported in this browser.');
          return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'ko-KR';
        utterance.rate = 0.85; // Slightly slower for language learners
        utterance.pitch = 1.0;

        if (btnElement) {
          btnElement.classList.add('ring-2', 'ring-indigo-500', 'scale-110');
          utterance.onend = () => btnElement.classList.remove('ring-2', 'ring-indigo-500', 'scale-110');
          utterance.onerror = () => btnElement.classList.remove('ring-2', 'ring-indigo-500', 'scale-110');
        }
        window.speechSynthesis.speak(utterance);
      }

      // 1. Wrap all Markdown tables in responsive container and enhance with Flashcard Active Recall
      const tables = article.querySelectorAll('table');
      tables.forEach(table => {
        // Ensure responsive wrapper to prevent mobile overflow
        if (!table.parentElement.classList.contains('overflow-x-auto')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'overflow-x-auto w-full my-6 rounded-2xl border border-slate-200 shadow-2xs';
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }

        const headerRow = table.querySelector('thead tr') || table.querySelector('tr');
        if (!headerRow) return;

        const headers = Array.from(headerRow.querySelectorAll('th, td')).map(cell => cell.textContent.trim().toLowerCase());
        const hangulColIdx = headers.findIndex(h => h.includes('hangul'));
        const romanColIdx = headers.findIndex(h => h.includes('roman'));
        const englishColIdx = headers.findIndex(h => h.includes('english') || h.includes('meaning'));

        if (hangulColIdx !== -1) {
          // Add TTS button to each Hangul cell in table body
          const rows = table.querySelectorAll('tbody tr');
          rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            if (cells[hangulColIdx]) {
              const hangulCell = cells[hangulColIdx];
              const wordText = hangulCell.textContent.trim();

              const miniTts = document.createElement('button');
              miniTts.type = 'button';
              miniTts.className = 'ml-1.5 p-1 rounded-md text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors cursor-pointer text-xs inline-block';
              miniTts.title = `Pronounce ${wordText}`;
              miniTts.innerHTML = '🔊';
              miniTts.addEventListener('click', (e) => {
                e.stopPropagation();
                speakKorean(wordText, miniTts);
              });
              hangulCell.appendChild(miniTts);
            }
          });
        }

        // Insert Flashcard Recall Action Bar above table
        if (englishColIdx !== -1 || romanColIdx !== -1) {
          const bar = document.createElement('div');
          bar.className = 'flex flex-wrap items-center justify-between gap-3 p-3.5 mb-2 bg-gradient-to-r from-indigo-50 to-purple-50/60 border border-indigo-100 rounded-2xl text-xs text-indigo-950 shadow-2xs';
          bar.innerHTML = `
            <div class="flex items-center gap-2 font-bold">
              <span class="text-base">🎴</span>
              <span>Flashcard Active Recall:</span>
              <span class="font-normal text-indigo-700 hidden md:inline">Tap hidden cells to test your memory</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="toggleEnglishBtn" class="px-2.5 py-1 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700 transition-colors shadow-2xs cursor-pointer">
                Hide English
              </button>
              <button type="button" id="toggleRomanBtn" class="px-2.5 py-1 rounded-lg bg-white text-slate-700 font-semibold hover:bg-slate-100 transition-colors border border-slate-200 cursor-pointer">
                Hide Romanization
              </button>
              <button type="button" id="exportAnkiBtn" class="px-2.5 py-1 rounded-lg bg-slate-900 text-white font-semibold hover:bg-slate-800 transition-colors shadow-2xs cursor-pointer">
                📥 Anki CSV
              </button>
            </div>
          `;

          const wrapper = table.parentElement;
          wrapper.parentNode.insertBefore(bar, wrapper);

          const engBtn = bar.querySelector('#toggleEnglishBtn');
          const romBtn = bar.querySelector('#toggleRomanBtn');
          const ankiBtn = bar.querySelector('#exportAnkiBtn');

          let hideEnglish = false;
          let hideRoman = false;

          // Toggle English Blur
          engBtn.addEventListener('click', () => {
            hideEnglish = !hideEnglish;
            engBtn.classList.toggle('bg-indigo-600', !hideEnglish);
            engBtn.classList.toggle('bg-pink-600', hideEnglish);
            engBtn.textContent = hideEnglish ? 'English Hidden (Tap)' : 'Hide English';

            const rows = table.querySelectorAll('tbody tr');
            rows.forEach(row => {
              const cells = row.querySelectorAll('td');
              if (cells[englishColIdx]) {
                const cell = cells[englishColIdx];
                if (hideEnglish) {
                  cell.classList.add('filter', 'blur-sm', 'cursor-pointer', 'select-none', 'hover:blur-none', 'transition-all');
                  cell.title = 'Click to reveal English';
                  cell.setAttribute('aria-hidden', 'true');
                  cell.setAttribute('role', 'button');
                  cell.setAttribute('tabindex', '0');
                  cell.onclick = () => {
                    const isBlurred = cell.classList.toggle('blur-sm');
                    cell.setAttribute('aria-hidden', isBlurred ? 'true' : 'false');
                  };
                } else {
                  cell.classList.remove('filter', 'blur-sm', 'cursor-pointer', 'select-none', 'hover:blur-none');
                  cell.title = '';
                  cell.removeAttribute('aria-hidden');
                  cell.removeAttribute('role');
                  cell.removeAttribute('tabindex');
                  cell.onclick = null;
                }
              }
            });
            if (hideEnglish) showToast('English hidden! Tap cells to reveal.', '🎴');
          });

          // Toggle Romanization Blur
          if (romanColIdx !== -1) {
            romBtn.addEventListener('click', () => {
              hideRoman = !hideRoman;
              romBtn.classList.toggle('bg-purple-600', hideRoman);
              romBtn.classList.toggle('text-white', hideRoman);
              romBtn.textContent = hideRoman ? 'Romanization Hidden (Hangul Only)' : 'Hide Romanization';

              const rows = table.querySelectorAll('tbody tr');
              rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells[romanColIdx]) {
                  const cell = cells[romanColIdx];
                  if (hideRoman) {
                    cell.classList.add('filter', 'blur-sm', 'cursor-pointer', 'select-none', 'hover:blur-none', 'transition-all');
                    cell.title = 'Click to reveal Romanization';
                    cell.setAttribute('aria-hidden', 'true');
                    cell.setAttribute('role', 'button');
                    cell.setAttribute('tabindex', '0');
                    cell.onclick = () => {
                      const isBlurred = cell.classList.toggle('blur-sm');
                      cell.setAttribute('aria-hidden', isBlurred ? 'true' : 'false');
                    };
                  } else {
                    cell.classList.remove('filter', 'blur-sm', 'cursor-pointer', 'select-none', 'hover:blur-none');
                    cell.title = '';
                    cell.removeAttribute('aria-hidden');
                    cell.removeAttribute('role');
                    cell.removeAttribute('tabindex');
                    cell.onclick = null;
                  }
                }
              });
              if (hideRoman) showToast('Romanization hidden! Practice reading pure Hangul.', '✨');
            });
          } else {
            romBtn.classList.add('hidden');
          }

          // Export Table to Anki CSV
          ankiBtn.addEventListener('click', () => {
            const rows = table.querySelectorAll('tbody tr');
            let csvContent = 'Hangul\tRomanization\tEnglish\tExample\n';
            rows.forEach(row => {
              const cells = Array.from(row.querySelectorAll('td')).map(c => {
                // clone to remove any TTS buttons
                const clone = c.cloneNode(true);
                clone.querySelectorAll('button').forEach(b => b.remove());
                return clone.textContent.trim().replace(/\t/g, ' ');
              });
              if (cells.length >= 3) {
                csvContent += `${cells[hangulColIdx] || ''}\t${cells[romanColIdx] || ''}\t${cells[englishColIdx] || ''}\t${cells[4] || ''}\n`;
              }
            });

            navigator.clipboard.writeText(csvContent).then(() => {
              showToast('Vocabulary copied in Anki Tab-delimited format!', '📥');
            });
          });
        }
      });

      // 2. Enhance Section 2: 3-Line Chorus Breakdown with Scope-based Traversal
      const listItems = article.querySelectorAll('li');
      listItems.forEach(li => {
        const text = li.textContent.trim();
        if (text.startsWith('Hangul:')) {
          const hangulText = text.replace(/^Hangul:\s*/, '').trim();

          // Create Action Buttons Container
          const actionsSpan = document.createElement('span');
          actionsSpan.className = 'inline-flex items-center gap-1.5 ml-2 align-middle';

          // TTS Button
          const ttsBtn = document.createElement('button');
          ttsBtn.type = 'button';
          ttsBtn.className = 'p-1 px-2 rounded-md bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white text-[11px] font-semibold transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs';
          ttsBtn.title = 'Listen in Korean';
          ttsBtn.innerHTML = '<span>🔊</span><span>Listen</span>';
          ttsBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            speakKorean(hangulText, ttsBtn);
          });

          // Copy Snippet Button with Scope-based Traversal
          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'p-1 px-2 rounded-md bg-slate-100 text-slate-700 hover:bg-slate-800 hover:text-white text-[11px] font-semibold transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs';
          copyBtn.title = 'Copy lyric block to Anki / Notes';
          copyBtn.innerHTML = '<span>📋</span><span>Copy</span>';
          copyBtn.addEventListener('click', (e) => {
            e.stopPropagation();

            let romanizationText = '';
            let englishText = '';

            // Search within parent list items
            const parent = li.parentElement;
            if (parent) {
              const allSiblings = Array.from(parent.children);
              const currentIdx = allSiblings.indexOf(li);
              for (let j = currentIdx + 1; j < allSiblings.length; j++) {
                const sibText = allSiblings[j].textContent.trim();
                if (sibText.startsWith('Romanization:') && !romanizationText) {
                  romanizationText = sibText.replace(/^Romanization:\s*/, '').trim();
                } else if (sibText.startsWith('English Translation:') && !englishText) {
                  englishText = sibText.replace(/^English Translation:\s*/, '').trim();
                } else if (sibText.startsWith('Hangul:')) {
                  break; // next verse
                }
              }
            }

            let snippet = `[Hangul] ${hangulText}\n`;
            if (romanizationText) snippet += `[Romanization] ${romanizationText}\n`;
            if (englishText) snippet += `[Meaning] ${englishText}\n`;

            navigator.clipboard.writeText(snippet.trim()).then(() => {
              showToast('Lyric block copied for Anki / Flashcards!', '✅');
            });
          });

          actionsSpan.appendChild(ttsBtn);
          actionsSpan.appendChild(copyBtn);
          li.appendChild(actionsSpan);
        }
      });
    });
  </script>
</BaseLayout>

